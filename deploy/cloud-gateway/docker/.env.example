# Copy to .env (or let `ctm_docker.py setup` write it). NO secrets belong in this file.
# Compose project name (keep stable: volumes are named after it).
CTM_PROJECT=coding-tools-gateway
# Gateway image: `docker load -i coding-tools-gateway-image-<VERSION>.tar` prints the id.
# Use the immutable id (sha256:...) or ghcr.io/<owner>/<repo>@sha256:<digest>. Never a mutable tag.
CTM_GATEWAY_IMAGE=sha256:<GATEWAY_IMAGE_ID>
# Official images pinned by digest (`docker pull` then `docker image inspect --format '{{index .RepoDigests 0}}'`).
CTM_POSTGRES_IMAGE=postgres@sha256:<POSTGRES_DIGEST>
CTM_INGRESS_IMAGE=nginx@sha256:<NGINX_DIGEST>
# Absolute private root (0700, created by setup). Holds config/runtime secrets as 0400/0600 files.
CTM_PRIVATE_ROOT=/opt/coding-tools-gateway/private
# Public hostname served by your TLS front proxy (Baota/Nginx/Caddy). Must match config.json origin.
CTM_DOMAIN=<GATEWAY_DOMAIN>
# Host loopback port published for the TLS front proxy.
CTM_PORT=28880
