"""Necessary real owned temporary-input controls; zero SUT methods."""
from pathlib import Path
import hashlib
import os
import stat
import tempfile
import unittest
from fixed_fixture import restore_owned_fixture

class FixedInputControls(unittest.TestCase):
    def setUp(self):self.tmp=tempfile.TemporaryDirectory();self.parent=Path(self.tmp.name);self.raw=b'owned ordinary fixed bytes';self.sha=hashlib.sha256(self.raw).hexdigest();self.parts=('new','input','fixed.crate')
    def tearDown(self):self.tmp.cleanup()
    def call(self,**kwargs):return restore_owned_fixture(kwargs.get('parent',self.parent),kwargs.get('parts',self.parts),kwargs.get('raw',self.raw),kwargs.get('sha',self.sha))
    def test_exact_copy_owned_modes_nlink_hash_close(self):
        result=self.call();p=self.parent.joinpath(*self.parts);self.assertEqual(p.read_bytes(),self.raw);self.assertEqual(stat.S_IMODE(p.stat().st_mode),0o600);self.assertEqual(p.stat().st_nlink,1);self.assertFalse(result['old_scratch_drafts_restored'])
        for p in [self.parent/'new',self.parent/'new/input']:self.assertEqual(stat.S_IMODE(p.stat().st_mode),0o700)
    def test_existing_empty_prefix_rejected(self):
        (self.parent/'new').mkdir()
        with self.assertRaises(FileExistsError):self.call()
        self.assertEqual(list((self.parent/'new').iterdir()),[])
    def test_replay_never_overwrites(self):
        self.call();p=self.parent.joinpath(*self.parts);identity=p.stat().st_ino
        with self.assertRaises(FileExistsError):self.call()
        self.assertEqual(p.stat().st_ino,identity);self.assertEqual(p.read_bytes(),self.raw)
    def test_existing_prefix_symlink_rejected(self):
        (self.parent/'target').mkdir();(self.parent/'new').symlink_to('target',target_is_directory=True)
        with self.assertRaises(FileExistsError):self.call()
        self.assertEqual(list((self.parent/'target').iterdir()),[])
    def test_parent_symlink_rejected(self):
        link=self.parent/'alias';link.symlink_to(self.parent,target_is_directory=True)
        with self.assertRaises(ValueError):self.call(parent=link)
    def test_wrong_raw_hash_no_creation(self):
        with self.assertRaises(ValueError):self.call(sha='0'*64)
        self.assertEqual(list(self.parent.iterdir()),[])
    def test_bad_component_no_creation(self):
        with self.assertRaises(ValueError):self.call(parts=('..','fixed'))
        self.assertEqual(list(self.parent.iterdir()),[])
    def test_nonbytes_no_creation(self):
        with self.assertRaises(ValueError):self.call(raw=bytearray(self.raw))
        self.assertEqual(list(self.parent.iterdir()),[])
    def test_real_foreign_parent_rejected(self):
        foreign=Path('/tmp');self.assertNotEqual(foreign.lstat().st_uid,os.geteuid())
        with self.assertRaises(ValueError):self.call(parent=foreign)

if __name__=='__main__':unittest.main(verbosity=2)
