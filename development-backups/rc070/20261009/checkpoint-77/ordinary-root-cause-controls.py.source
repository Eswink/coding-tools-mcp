class Alias:
 def __init__(self,name,original,error=None,when=None):
  object.__setattr__(self,'name',name);object.__setattr__(self,'original',original);object.__setattr__(self,name,original)
  object.__setattr__(self,'attempts',[]);object.__setattr__(self,'error',error);object.__setattr__(self,'when',when)
 def __setattr__(self,name,value):
  if name==self.name:
   self.attempts.append(value)
   count=len(self.attempts)
   if self.when and count==self.when[0]:
    if self.when[1]=='after':object.__setattr__(self,name,value)
    raise self.error
  object.__setattr__(self,name,value)
