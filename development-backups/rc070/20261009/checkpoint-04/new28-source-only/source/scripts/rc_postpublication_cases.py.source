"""Real loopback TLS / owned bytes only; no publication or installation grant."""
from contextlib import ExitStack, contextmanager
from dataclasses import replace
import hashlib
import json
import os
from pathlib import Path
import stat
import tempfile
import threading
import time
import unittest
from unittest.mock import patch
import rc_publication_github as wire
from rc_publication_https_fixture import HTTPSFixture
import rc_publication_stage_cases as fixtures
from rc_consumer_io import ConsumerError
from rc_postpublication_contract import CaptureRequest, WORKFLOW, MANIFEST
from rc_postpublication_source import ReadController, original_stage, _ReferenceAPI
from rc_postpublication_reader import PublishedInputs
from rc_postpublication_io import InputOwner


class PostSourceFixture(fixtures.SourceFixture):
    def commit_source(self):
        target = self.root / WORKFLOW
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes((fixtures.ROOT / WORKFLOW).read_bytes())
        super().commit_source()


@contextmanager
def public_fixture():
    """Synthetic GitHub shapes; real committed source, TLS, worker IPC and IO."""
    with patch.object(fixtures, 'SourceFixture', PostSourceFixture), fixtures.publisher_fixture() as f:
        request = CaptureRequest(f.selection, 100, tuple(range(300, 306)))
        with HTTPSFixture(f.selection.subject, f.plan, f.payloads) as tls:
            tls.release = dict(id=100, tag_name=f.selection.subject.tag,
                target_commitish=f.source.sha, draft=False, prerelease=True, published_at='2026-10-01T01:00:00Z')
            for ident, asset in zip(request.asset_ids, f.plan.assets):
                row = dict(id=ident, name=asset.name, content_type=asset.media_type,
                    size=asset.size, digest='sha256:' + asset.sha256, state='uploaded')
                tls.assets[ident] = row, f.payloads[asset.name]
            tls.route = lambda *args: fixtures.artifact_route(f, *args)
            with patch.object(wire, '_connect', side_effect=tls.connect), fixtures.artifact_worker(f, tls):
                controls = ReadController()
                try:
                    with original_stage(f.root, request, 'fixture-actions-read-token', controls,
                                        temporary_parent=f.parent) as stage:
                        yield f, tls, request, controls, stage
                finally:
                    controls.close()


class PostpublicationCases(unittest.TestCase):
    def test_external_sink_rejected_before_body_retention(self):
        with HTTPSFixture() as tls, patch.object(wire, '_connect', side_effect=tls.connect):
            with wire._connect(wire.API, 3) as sock:
                sock.sendall(('GET ' + wire.ROOT + '/releases/latest HTTP/1.1\r\nHost: ' +
                              wire.API + '\r\nConnection: close\r\n\r\n').encode())
                import time
                reader = wire._Reader(sock, time.monotonic() + 3, lambda: None)
                with self.assertRaises(wire.WireFailure) as found:
                    reader.response(1024, binary=True, sink=object())
                self.assertEqual((found.exception.code, found.exception.effect), ('invalid_request', 'none'))

    def test_six_actual_anonymous_files_and_retirement(self):
        with public_fixture() as (f, tls, request, controls, stage):
            self.assertIs(stage._api._selection, stage._selection)
            self.assertIs(stage._api._api.selection, stage._selection)
            start = len(tls.requests)
            with PublishedInputs(stage, request, controls, temporary_parent=f.parent) as inputs:
                path = inputs._owner._root.path
                self.assertEqual(set(inputs._owner._root.files()), set(f.payloads))
                for asset in stage.plan.assets:
                    self.assertEqual(inputs._owner._root.read(asset.name), f.payloads[asset.name])
                    self.assertEqual(stat.S_IMODE((path / asset.name).stat().st_mode), 0o600)
                inputs.revalidate()
            self.assertFalse(path.exists())
            public = [r for r in tls.requests[start:] if r[1].startswith(wire.ROOT + '/releases')
                      or r[1].startswith(wire.ROOT + '/git/ref/')]
            # Stage's authenticated source checks are audited separately. All
            # numeric public asset requests, including metadata, are anonymous.
            downloads = [r for r in public if r[1].startswith(wire.ROOT + '/releases/assets/')]
            self.assertEqual({int(r[1].rsplit('/',1)[1]) for r in downloads}, set(request.asset_ids))
            self.assertTrue(all('authorization' not in r[2] and 'cookie' not in r[2] and r[0]=='GET'
                                and r[3]==b'' for r in downloads))

    def test_one_storage_redirect_retains_only_public_body(self):
        with public_fixture() as (f, tls, request, controls, stage):
            tls.redirects[300] = 'https://' + wire.STORAGE + '/asset/300?fixture=public'
            with PublishedInputs(stage, request, controls, temporary_parent=f.parent) as inputs:
                self.assertEqual(inputs._owner._root.read(stage.plan.assets[0].name), f.payloads[stage.plan.assets[0].name])
            storage = [r for r in tls.requests if r[2].get('host') == wire.STORAGE]
            self.assertEqual(len(storage), 1)
            self.assertNotIn('authorization', storage[0][2])
            self.assertNotIn('cookie', storage[0][2])

    def test_redirect_and_error_bodies_never_create_installable_input(self):
        for status in (302, 404):
            with self.subTest(status=status), tempfile.TemporaryDirectory() as parent, HTTPSFixture() as tls:
                controls = ReadController()
                owner = InputOwner(parent, Path(__file__).parents[1], controls)
                asset = next(iter(tls.plan.assets))
                tls.routes[('GET', wire.ROOT + '/releases/latest')] = status, {}, b'error-not-installer'
                with owner.sink(asset) as sink, tls.connect(wire.API, 3) as sock:
                    sock.sendall(('GET '+wire.ROOT+'/releases/latest HTTP/1.1\r\nHost: '+wire.API+'\r\n\r\n').encode())
                    measured = wire._Reader(sock, controls._deadline, controls.check).response(1024, True, sink=sink)
                    self.assertEqual(measured[0], status)
                self.assertEqual(owner._root.files(), ())
                path = owner._root.path
                owner.close(); controls.close()
                self.assertFalse(path.exists())

    def test_corrupt_public_asset_fails_and_owned_partial_retires(self):
        with public_fixture() as (f, tls, request, controls, stage):
            row, body = tls.assets[300]
            tls.assets[300] = row, bytes([body[0] ^ 1]) + body[1:]
            inputs = PublishedInputs(stage, request, controls, temporary_parent=f.parent)
            path = inputs._owner._root.path
            with self.assertRaises(ConsumerError) as found:
                inputs.__enter__()
            self.assertEqual(found.exception.code, 'post_input_digest_changed')
            self.assertFalse(inputs._verified)
            self.assertFalse(path.exists())

    def test_foreign_storage_and_second_redirect_denied(self):
        for location in ('https://example.invalid/asset/300', 'https://' + wire.STORAGE + '/asset/300'):
            with self.subTest(location=location), public_fixture() as (f, tls, request, controls, stage):
                tls.redirects[300] = location
                if wire.STORAGE in location:
                    tls.routes[('GET','/asset/300')] = 302, {'Location':location}, b''
                inputs = PublishedInputs(stage, request, controls, temporary_parent=f.parent)
                path = inputs._owner._root.path
                with self.assertRaises(ConsumerError) as found:
                    inputs.__enter__()
                self.assertIn(found.exception.code, ('post_storage_denied','post_second_redirect'))
                self.assertFalse(path.exists())

    def test_owned_cancel_and_expiry_reject_noop_caller_before_get(self):
        with public_fixture() as (f, tls, request, controls, stage):
            start = len(tls.requests)
            controls.cancel()
            called = []
            with self.assertRaises(wire.WireFailure) as found:
                stage._api.get('/', deadline=time.monotonic()+900, check_active=lambda: called.append(True))
            self.assertEqual((found.exception.code, found.exception.effect), ('cancelled','none'))
            self.assertEqual(called, [])
            self.assertEqual(len(tls.requests), start)
        controls = ReadController(seconds=0.01)
        time.sleep(0.02)
        with self.assertRaises(wire.WireFailure) as found:
            controls.check()
        self.assertEqual(found.exception.code, 'timeout')
        controls.close()

    def test_mutated_reference_token_or_selection_is_denied(self):
        with public_fixture() as (f, tls, request, controls, stage):
            start = len(tls.requests)
            native = stage._api._api
            original = native.token
            native.token = 'different-fixture-read-token'
            with self.assertRaises(ConsumerError) as found:
                stage._api.get('/')
            self.assertEqual(found.exception.code, 'post_reference_changed')
            native.token = original
            selected = native.selection
            native.selection = request.selection
            self.assertIsNot(native.selection, stage._selection)
            with self.assertRaises(ConsumerError):
                stage._api.get('/')
            native.selection = selected
            self.assertEqual(len(tls.requests), start)

    def test_caller_mutation_cannot_change_native_encoded_get_credential(self):
        with public_fixture() as (f, tls, request, controls, stage):
            native, before = stage._api._api, len(tls.requests)
            original = native.token
            called = []
            def change():
                called.append(True)
                native.token = 'different-fixture-read-token'
            try:
                with self.assertRaises(wire.WireFailure) as found:
                    stage._api.get('/', check_active=change)
                self.assertEqual((found.exception.code,found.exception.effect),('adapter_error','none'))
                self.assertEqual(called,[True])
                self.assertEqual(len(tls.requests),before)
            finally:
                native.token = original

    def test_actual_binary_tls_cancel_is_owned_and_partial_retires(self):
        with public_fixture() as (f,tls,request,controls,stage):
            original_route=tls.route
            triggered=[]
            def route(method,path,headers,body):
                if path==wire.ROOT+'/releases/assets/300' and headers.get('accept')=='application/octet-stream':
                    triggered.append(True)
                    controls.cancel()
                return original_route(method,path,headers,body)
            tls.route=route
            inputs=PublishedInputs(stage,request,controls,temporary_parent=f.parent)
            path=inputs._owner._root.path
            with self.assertRaises(ConsumerError) as found:
                inputs.__enter__()
            self.assertEqual(found.exception.code,'post_cancelled')
            self.assertEqual(triggered,[True])
            self.assertFalse(path.exists())
            self.assertFalse(inputs._verified)

    def test_actual_binary_tls_callee_expiry_does_not_renew_owned_budget(self):
        with public_fixture() as (f,tls,request,controls,stage):
            inputs=PublishedInputs(stage,request,controls,temporary_parent=f.parent)
            api=inputs._api
            remote=api.inventory()[0]
            send=wire.ssl.SSLSocket.sendall
            trigger=[]
            target=f.payloads[remote.asset.name]
            def delayed(sock,data,*args,**kwargs):
                if sock.context is tls.context and data.endswith(target) and data.startswith(b'HTTP/1.1 200'):
                    header,body=data.split(b'\r\n\r\n',1)
                    send(sock,header+b'\r\n\r\n'+body[:1],*args,**kwargs)
                    trigger.append(True)
                    time.sleep(0.1)
                    return send(sock,body[1:],*args,**kwargs)
                return send(sock,data,*args,**kwargs)
            before=controls._deadline
            try:
                with inputs._owner.sink(remote.asset) as sink, patch.object(wire.ssl.SSLSocket,'sendall',delayed):
                    with self.assertRaises(ConsumerError):
                        api._request('GET',wire.API,wire.ROOT+'/releases/assets/'+str(remote.asset_id),
                            anonymous=True,binary=True,limit=remote.asset.size,
                            deadline=time.monotonic()+0.03,sink=sink)
                self.assertEqual(trigger,[True])
                self.assertEqual(controls._deadline,before)
                self.assertFalse(inputs._verified)
            finally:
                path=inputs._owner._root.path
                inputs.close()
            self.assertFalse(path.exists())

    def test_late_release_change_after_six_bodies_withdraws_input_success(self):
        with public_fixture() as (f,tls,request,controls,stage):
            original_route=tls.route
            bodies=[]
            def route(method,path,headers,body):
                if path.startswith(wire.ROOT+'/releases/assets/') and headers.get('accept')=='application/octet-stream':
                    bodies.append(path)
                if len(bodies)==6 and path==wire.ROOT+'/releases/100':
                    tls.release['draft']=True
                return original_route(method,path,headers,body)
            tls.route=route
            inputs=PublishedInputs(stage,request,controls,temporary_parent=f.parent)
            path=inputs._owner._root.path
            with self.assertRaises(ConsumerError) as found:
                inputs.__enter__()
            self.assertEqual(found.exception.code,'post_release_not_public')
            self.assertEqual(len(bodies),6)
            self.assertFalse(inputs._verified)
            self.assertFalse(path.exists())

    def test_wrong_thread_controller_and_canonical_source_rejected(self):
        controls = ReadController()
        errors = []
        thread = threading.Thread(target=lambda: self._thread_check(controls, errors))
        thread.start(); thread.join(3)
        self.assertFalse(thread.is_alive())
        self.assertEqual(errors, ['post_owner_changed'])
        controls.close()

    @staticmethod
    def _thread_check(controls, errors):
        try:
            controls.check()
        except ConsumerError as error:
            errors.append(error.code)

    def test_unentered_stage_and_foreign_controller_never_create_authority(self):
        from rc_publication_stage import stage_selected
        with public_fixture() as (f, tls, request, controls, stage):
            unentered = stage_selected(f.root, request.selection, f.api, temporary_parent=f.parent)
            with self.assertRaises(ConsumerError):
                PublishedInputs(unentered, request, controls, temporary_parent=f.parent)
            foreign = ReadController()
            before = len(tls.requests)
            with self.assertRaises(ConsumerError) as found:
                PublishedInputs(stage, request, foreign, temporary_parent=f.parent)
            self.assertEqual(found.exception.code, 'invalid_post_reference')
            self.assertEqual(len(tls.requests), before)
            foreign.close()
