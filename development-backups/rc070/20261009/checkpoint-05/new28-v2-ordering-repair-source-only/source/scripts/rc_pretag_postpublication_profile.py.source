ect(ref, root, git, entries, historical, release, release_tree, documents)\\n    if selected is not None:\\n        return selected\\n\'\nNORMALIZE = b\'    from rc_pretag_source_observation_profile import normalize as source_observation_bytes\\n    current = source_observation_bytes(path, current)\\n\'\nNEW_CASES = {\n    \'rc_consumer_source_git_cases.SourceGitCases\': (\'test_nine_typed_operations_preserve_exact_native_outputs_and_launches\', \'test_dynamic_operands_reject_before_launch_without_new_command_authority\', \'test_quiet_predicates_only_accept_empty_stdout_and_exit_zero_or_one\', \'test_commit_tag_tree_framing_and_fixed_caps_reject_malformed_output\', \'test_raw_blob_bytes_and_absent_tree_entry_are_not_decoded_or_stripped\', \'test_tracked_staged_untracked_and_ignored_dirtiness_keep_distinct_meaning\', \'test_gitlink_and_nonzero_index_stages_precede_tracked_diff\', \'test_source_children_drop_inherited_environment_and_reject_helper_network_config\', \'test_callback_only_source_commands_do_not_create_an_operation_clock\', \'test_each_source_operation_timeout_and_cancel_reaps_the_known_child\', \'test_rc_default_and_controlled_outputs_match_and_invalid_versions_precede_controls\', \'test_rc_dirty_and_wrong_sha_diagnostics_precede_post_read_cancellation\', \'test_stable_default_remains_legacy_and_controlled_stable_fails_closed\', \'test_frozen_manifest_outputs_match_with_one_shared_review_reader\', \'test_reviewed_ancestry_failure_precedes_late_cancellation\', \'test_reviewed_manifest_mutations_retain_closed_semantic_failures\', \'test_missing_manifest_candidate_symlink_and_bad_manifest_json_fail_closed\', \'test_completed_manifest_failure_precedes_next_budget_callback\', \'test_malformed_diff_framing_status_and_tree_descriptor_do_not_gain_success\'),\n    \'rc_publication_source_budget_cases.SourceBudgetCases\': (\'test_default_source_has_empty_downstream_kwargs_and_no_reader_or_clock\', \'test_full_source_observation_has_four_owners_and_exact_87_children\', \'test_activation_reuses_original_pair_for_both_source_passes_and_bundle\', \'test_one_absolute_deadline_spans_source_readers_without_renewal\', \'test_callback_only_full_source_does_not_read_an_operation_clock\', \'test_invalid_or_expired_controls_create_no_child_or_private_root\', \'test_initial_source_timeout_reaps_before_any_private_stage_root\', \'test_initial_source_cancellation_owns_and_reaps_child_before_cleanup\', \'test_revalidation_uses_fresh_current_pair_after_activation_has_expired\', \'test_local_untracked_tree_tag_and_workflow_failures_precede_late_cancellation\', \'test_ignored_untracked_file_is_rejected_before_reviewed_manifest_reader\', \'test_later_source_cancel_and_timeout_preserve_existing_mutation_effects\', \'test_source_cleanup_uncertainty_retains_bytes_and_is_sticky_after_prior_effect\'),\n    \'rc_pretag_source_observation_cases.SourceObservationCompositionCases\': (\'test_actual_f_identity_and_fresh_historical_validation\', \'test_exact_ordered_d_i_j_and_four_document_overlay\', \'test_wrong_repeated_nested_and_same_tree_topologies_reject\', \'test_nineteen_exact_paths_modes_pins_and_entry_count\', \'test_individual_and_aggregate_caps_reject\', \'test_twelve_full_byte_inverses_and_six_dispatch_lines\', \'test_finite_historical_identities_are_exact_and_immutable\', \'test_missing_duplicate_outside_and_binary_inverse_changes_reject\', \'test_selected_historical_and_release_failures_are_terminal\', \'test_current_candidate_is_never_cached\', \'test_original1553_strict303_consumer452_ids_and_assertions_are_preserved\', \'test_new44_inventory_early_runtime_workflow_and_exceptional_outcomes\'),\n}\nCLASS = \'rc_pretag_source_observation_cases.SourceObservationCompositionCases\'\nDIGEST = \'7dd73a6fd939e3bfae86999ffcf088a6e3679cc4d20e542dc5677599680bc211\'\n\n\ndef normalize(path, current):\n    """Reverse only sealed new bytes; historical passthrough is a finite pin list."""\n    from rc_pretag_postpublication_profile import normalize as postpublication_bytes\n    current = postpublication_bytes(path, current)\n    from rc_pretag_windows_launch_profile import normalize as windows_launch_bytes\n    current = windows_launch_bytes(path, current)\n    assert type(path) is str and type(current) is bytes, \'source_observation inverse input\'\n    if path not in BASE_PINS:\n        return current\n    identity = o.pin(current)\n    baseline = BASE_PINS[path]\n    if identity == baseline[1:3] or identity in PRIOR_PINS.get(path, ()):\n        return current\n    row = SOURCE_PINS[path]\n    assert (identity, len(current), len(current.splitlines())) == (row[1:3], row[3], row[4]), path\n    restored = current\n    for before, after in reversed(FRAGMENTS[path]):\n        assert before and restored.count(before) == 1, \'source_observation fragment missing or duplicated\'\n        restored = restored.replace(before, after, 1)\n    assert (o.pin(restored), len(restored), len(restored.splitlines())) == (\n        baseline[1:3], baseline[3], baseline[4]), \'complete source_observation F inverse\'\n    return restored\n\ndef topology(ref, root, git, release):\n    """Only D[M], I[M,D], J[R,I]; no correction chains or ancestry inference."""\n    if release != p.R:\n        raise o.TopologyError(\'source_observation_release_anchor\')\n    parents = o._parents(ref, root, git)\n    if parents == [M]:\n        kind, tip, source = \'nonrelease\', ref, ref\n    elif len(parents) == 2 and parents[0] == M:\n        kind, tip, source = \'nonrelease\', ref, parents[1]\n    elif len(parents) == 2 and parents[0] == p.R:\n        kind, tip = \'release\', parents[1]\n        feature_parents = o._parents(tip, root, git)\n        if len(feature_parents) != 2 or feature_parents[0] != M:\n            raise o.TopologyError(\'source_observation_feature_parents\')\n        source = feature_parents[1]\n    else:\n        raise o.TopologyError(\'source_observation_candidate_parents\')\n    if o._parents(source, root, git) != [M]:\n        raise o.TopologyError(\'source_observation_candidate_parent\')\n    return kind, tip, source\n\ndef content(ref, root, git, entries, historical, release, release_tree, documents):\n    """Fresh immutable M admission, exact candidate pins and complete reviewed delta."""\n    assert (release, release_tree, documents) == (p.R, p.R_TREE, p.R_DOCUMENTS)\n    assert tuple(o._parents(M, root, git)) == M_PARENTS, \'source_observation M parents\'\n    assert git(\'rev-parse\', M + \'^{tree}\', root=root).decode().strip() == M_TREE, \'source_observation M tree\'\n    raw = git(\'cat-file\', \'commit\', M, root=root)\n    assert (len(raw), hashlib.sha256(raw).hexdigest()) == M_RAW, \'source_observation M raw\'\n    baseline = p.selected_profile(M, root, git, entries, historical, release, release_tree, documents)\n    assert baseline == entries(M, root) and len(baseline) == 1833\n    actual, paths = entries(ref, root), CAPS.keys()\n    assert len(paths) == 19 and SOURCE_PINS.keys() == paths - {PROFILE}\n    assert baseline.keys() & paths == BASE_PINS.keys() and len(BASE_PINS) == 12\n    assert FRAGMENTS.keys() == BASE_PINS.keys() and PRIOR_PINS.keys() <= BASE_PINS.keys()\n    assert len(PRIOR_PINS) == 5 and sum(map(len, PRIOR_PINS.values())) == 17\n    assert actual.keys() == baseline.keys() | paths and len(actual) == 1840\n    assert {path for path in actual if actual[path] != baseline.get(path)} == paths\n    assert all(actual[path] == value for path, value in baseline.items() if path not in paths)\n    assert all(actual[path][:2] == (\'100644\', \'blob\') for path in paths)\n    assert all(actual[path] == (row[0], \'blob\', row[1]) for path, row in SOURCE_PINS.items())\n    data = {path: git(\'cat-file\', \'blob\', actual[path][2], root=root) for path in paths}\n    for path, (mode, blob, digest, size, count) in SOURCE_PINS.items():\n        assert mode == \'100644\' and o.pin(data[path]) == (blob, digest), path\n        assert (len(data[path]), len(data[path].splitlines())) == (size, count), path\n    for path, row in BASE_PINS.items():\n        assert baseline[path] == (row[0], \'blob\', row[1]), path\n        assert normalize(path, data[path]) == git(\'cat-file\', \'blob\', baseline[path][2], root=root), path\n    p.authenticated._budgets(ref, M, root, git, data, CAPS, DELTA_LIMIT, \'source_observation_delta_budget\')\n    return actual\n\ndef select(ref, root, git, entries, historical, release, release_tree, documents):\n    """Only topology mismatch delegates; selected and historical content errors escape."""\n    ref = o._commit(ref, root, git)\n    import rc_pretag_postpublication_profile as postpublication\n    selected = postpublication.select(ref, root, git, entries, historical, release, release_tree, documents)\n    if selected is not None:\n        return selected\n    import rc_pretag_windows_launch_profile as windows_launch\n    selected = windows_launch.select(ref, root, git, entries, historical, release, release_tree, documents)\n    if selected is not None:\n        return selected\n    try:\n        kind, tip, source = topology(ref, root, git, release)\n    except o.TopologyError:\n        return None\n    expected = content(source, root, git, entries, historical, release, release_tree, documents)\n    assert entries(tip, root) == expected\n    if kind == \'release\':\n        return o.release_content(ref, expected, root, git, entries, release, release_tree, documents)\n    return expected\n', b'"""Finite source-observation Git budget admission; independent full-tree review binds self-bytes."""\nimport hashlib\nimport rc_pretag_ownership_profile as o\nimport rc_pretag_publication_profile as p\n\nM = \'649dc0fcb0bd299ebf7910e567e09c32b7962a9b\'\nM_TREE = \'956807f8c35b6ce12272b3abcfbbd85493e9c9f9\'\nM_PARENTS = (\'7eb98b76a15f91d2ad59ec8fbde4dd4fb17b1116\', \'970b5aba7b69b3a9d0a86c85e6cbaeac72839e9a\')\nM_RAW = (1231, \'41bbff566ee4cf1501ddcfa9b67f9e009cd9f97865716e67b8d6cf27a8b73f61\')\nPROFILE = \'scripts/rc_pretag_source_observation_profile.py\'\nCASES = \'scripts/rc_pretag_source_observation_cases.py\'\nDISPATCHER = \'scripts/rc_pretag_windows_vm_profile.py\'\nWORKFLOW = \'.github/workflows/issue88-publication-executor.yml\'\nCAPS = {\n    \'.github/workflows/issue88-publication-executor.yml\': (187, 50),\n    \'docs/specs/issue88-source-observation-budget/design.md\': (87, 87),\n    \'docs/specs/issue88-source-observation-budget/requirements.md\': (51, 51),\n    \'docs/specs/issue88-source-observation-budget/tasks.md\': (49, 49),\n    \'scripts/rc_consumer_fixed_git.py\': (468, 86),\n    \'scripts/rc_consumer_source_git_cases.py\': (397, 397),\n    \'scripts/rc_pretag_git_budget_cases.py\': (342, 5),\n    \'scripts/rc_pretag_source_observation_cases.py\': (352, 352),\n    \'scripts/rc_pretag_source_observation_profile.py\': (182, 182),\n    \'scripts/rc_pretag_stage_retirement_cases.py\': (364, 3),\n    \'scripts/rc_pretag_windows_vm_cases.py\': (351, 21),\n    \'scripts/rc_pretag_windows_vm_profile.py\': (182, 6),\n    \'scripts/rc_publication_git_budget_cases.py\': (260, 40),\n    \'scripts/rc_publication_source_budget_cases.py\': (375, 375),\n    \'scripts/rc_publication_stage.py\': (379, 65),\n    \'scripts/rc_publication_staging_budget_cases.py\': (361, 4),\n    \'scripts/rc_version_gate.py\': (123, 18),\n    \'scripts/reviewed_source_gate.py\': (166, 47),\n    \'scripts/source_provenance_gate.py\': (41, 6),\n}\nBASE_PINS = {\n    \'.github/workflows/issue88-publication-executor.yml\': (\'100644\', \'0bcc32d8c8cf8fe7ae1067bbb7b6cb7ea3fa686f\', \'7c04fe2a37ce4ad1f8e2dee685e71132ee9660b9acdd84beb678a7d35badefac\', 15358, 177),\n    \'scripts/rc_consumer_fixed_git.py\': (\'100644\', \'64e4a35c8c77a29db52aa89c63509aba975d1a73\', \'2dd3aa618e8cc80355a02fb1fbbbd228e5f87c4723b3096cd9f66e490da1809a\', 18034, 398),\n    \'scripts/rc_pretag_git_budget_cases.py\': (\'100644\', \'62ab5b5522ac339cd735b7ae447e8980f231cc54\', \'dd39d371def695eaac1b34217d23c0a0a63f7be72eba8887b4e2288a1bfa