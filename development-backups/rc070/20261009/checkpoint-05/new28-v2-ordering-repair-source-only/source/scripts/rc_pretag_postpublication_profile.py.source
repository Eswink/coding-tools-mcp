    ('scripts/rc_publication_stage.py', ('100644', 'ac41bd2c99fcabdb81eb9b1125f3aaca937baa80', 'e77ef98244c25e0bab1b136d0e6df1c0dbbf6fec24bec84e992f9c34dc99c313', 19163, 315), '564a68d42463b3e3b526d875970dd631da2e3eec'),
    ('scripts/rc_publication_stage.py', ('100644', 'b4ecb6e7400c1937b68f1ac960e2f6f0ecda4b65', 'b5d0e8f575f24e9977989b183f7ca415bb7cdf0e6142d645b98ddeeab12c6216', 18170, 295), 'd13ffd7dd6b90f5cfb73d78395a4944df92924c0'),
)

def require_sealed():
    """Fixed source schema; external whole-tree review binds this self-unpinned file."""
    assert SEALED is True, 'UNSEALED postpublication source family'
    assert (len(P_RAW_BYTES), hashlib.sha256(P_RAW_BYTES).hexdigest()) == P_RAW
    assert hashlib.sha1(b'commit ' + str(len(P_RAW_BYTES)).encode() + b'\0' + P_RAW_BYTES).hexdigest() == P
    assert P_RAW_BYTES.split(b'\n')[0] == ('tree ' + P_TREE).encode()
    assert tuple(line[7:].decode() for line in P_RAW_BYTES.split(b'\n') if line.startswith(b'parent ')) == P_PARENTS
    assert len(CAPS) == 28 and SOURCE_PINS.keys() == CAPS.keys() - {PROFILE}
    assert BASE_PINS.keys() == FRAGMENTS.keys() and len(BASE_PINS) == 10
    assert len(IDENTITY_PINS) == 26 and len(set((path, row[1]) for path, row, anchor in IDENTITY_PINS)) == 26
    assert sum(row == BASE_PINS[path] for path, row, anchor in IDENTITY_PINS) == 10
    assert all(path in BASE_PINS and row[0] == '100644' and len(row[1]) == 40 and len(row[2]) == 64 for path, row, anchor in IDENTITY_PINS)
    assert len(IDENTITY_ANCHORS) == 14 and {anchor for path, row, anchor in IDENTITY_PINS} == IDENTITY_ANCHORS.keys()
    for anchor, raw in IDENTITY_ANCHORS.items():
        assert hashlib.sha1(b'commit ' + str(len(raw)).encode() + b'\0' + raw).hexdigest() == anchor


def normalize(path, current):
    """Pure local complete inverse; the only passthroughs are exact finite identities."""
    require_sealed()
    assert type(path) is str and type(current) is bytes, 'postpublication inverse input'
    if path not in BASE_PINS:
        return current
    identity = ('100644', *o.pin(current), len(current), len(current.splitlines()))
    if any(path == named and identity == row for named, row, anchor in IDENTITY_PINS):
        return current
    assert identity == SOURCE_PINS[path], 'postpublication unlisted or dirty bytes: ' + path
    restored = current
    for before, after in reversed(FRAGMENTS[path]):
        assert type(before) is bytes and type(after) is bytes and before
        assert restored.count(before) == 1, 'postpublication fragment missing or duplicated'
        restored = restored.replace(before, after, 1)
    assert ('100644', *o.pin(restored), len(restored), len(restored.splitlines())) == BASE_PINS[path], 'complete postpublication D6 inverse'
    return restored


def windows_legacy_bytes(path, current):
    """Fixed two-layer operand adaptation; no callback or reader is accepted."""
    return windows.normalize(path, normalize(path, current))


def topology(ref, root, git, release):
    """Only D[P], I[F13,D], J[R,I]; matched-family failures remain terminal."""
    require_sealed()
    parents = o._parents(ref, root, git)
    if parents == [P]:
        kind, tip, source = 'nonrelease', ref, ref
    elif len(parents) == 2 and parents[0] == windows.M:
        kind, tip, source = 'nonrelease', ref, parents[1]
        if o._parents(source, root, git) != [P]:
            raise o.TopologyError('postpublication_nonfamily_feature')
    elif len(parents) == 2 and parents[0] == p.R:
        kind, tip = 'release', parents[1]
        feature_parents = o._parents(tip, root, git)
        if len(feature_parents) != 2 or feature_parents[0] != windows.M:
            raise o.TopologyError('postpublication_nonfamily_release')
        source = feature_parents[1]
        if o._parents(source, root, git) != [P]:
            raise o.TopologyError('postpublication_nonfamily_source')
    else:
        raise o.TopologyError('postpublication_candidate_parents')
    assert release == p.R, 'postpublication selected release anchor'
    assert tuple(o._parents(P, root, git)) == P_PARENTS, 'postpublication actual P parents'
    assert git('rev-parse', P + '^{tree}', root=root).decode().strip() == P_TREE, 'postpublication actual P tree'
    assert git('cat-file', 'commit', P, root=root) == P_RAW_BYTES, 'postpublication actual P raw'
    return kind, tip, source


def content(ref, root, git, entries, historical, release, release_tree, documents):
    """Fresh actual-parent admission followed by every current entry before return."""
    require_sealed()
    assert (release, release_tree, documents) == (p.R, p.R_TREE, p.R_DOCUMENTS)
    assert tuple(o._parents(P, root, git)) == P_PARENTS
    assert git('rev-parse', P + '^{tree}', root=root).decode().strip() == P_TREE
    assert git('cat-file', 'commit', P, root=root) == P_RAW_BYTES
    baseline = entries(P, root)
    assert len(baseline) == 1849, 'postpublication native parent entry map'
    actual, paths = entries(ref, root), CAPS.keys()
    assert baseline.keys() & paths == BASE_PINS.keys()
    assert actual.keys() == baseline.keys() | paths and len(actual) == 1867
    assert {path for path in actual if actual[path] != baseline.get(path)} == paths
    assert all(actual[path] == row for path, row in baseline.items() if path not in paths)
    assert all(actual[path][:2] == ('100644', 'blob') for path in paths)
    assert all(actual[path] == (row[0], 'blob', row[1]) for path, row in SOURCE_PINS.items())
    data = {path: git('cat-file', 'blob', actual[path][2], root=root) for path in paths}
    for path, row in SOURCE_PINS.items():
        assert ('100644', *o.pin(data[path]), len(data[path]), len(data[path].splitlines())) == row, path
    for anchor, raw in IDENTITY_ANCHORS.items():
        assert git('cat-file', 'commit', anchor, root=root) == raw, 'postpublication identity commit'
    for path, row, anchor in IDENTITY_PINS:
        assert entries(anchor, root)[path] == (row[0], 'blob', row[1]), 'postpublication identity native path/mode'
        raw = git('cat-file', 'blob', row[1], root=root)
        assert ('100644', *o.pin(raw), len(raw), len(raw.splitlines())) == row, 'postpublication identity native blob'
    for path, row in BASE_PINS.items():
        assert baseline[path] == (row[0], 'blob', row[1]), path
        assert normalize(path, data[path]) == git('cat-file', 'blob', row[1], root=root), path
    p.authenticated._budgets(ref, P, root, git, data, CAPS, DELTA_LIMIT, 'postpublication_delta_budget')
    verified_parent = windows.select(P, root, git, entries, historical, release, release_tree, documents)
    assert verified_parent == baseline, 'postpublication fresh actual parent source after current validation'
    return actual


def select(ref, root, git, entries, historical, release, release_tree, documents):
    """Delegate only a grammar mismatch; parent/content/release errors never fall back."""
    require_sealed()
    ref = o._commit(ref, root, git)
    try:
        kind, tip, source = topology(ref, root, git, release)
    except o.TopologyError:
        return None
    expected = content(source, root, git, entries, historical, release, release_tree, documents)
    assert entries(tip, root) == expected, 'postpublication D/I exact current source'
    if kind == 'release':
        return o.release_content(ref, expected, root, git, entries, release, release_tree, documents)
    return expected
