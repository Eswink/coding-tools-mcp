D6_CURRENT_ROLE = {'raw_bytes': 852, 'raw_sha256': '361d31359dab6dfd2c247c5382dbffe07a82236c4e6a9c09f5242e6dd7434e08', 'tree': '064252014dc0ad3c3882fbd5aef1968b083f8bb0', 'ordered_parents': ['110b4febbbcdab0138e2d28de2a53e2f2d61d7d6']}

def read(repo, *args):
    return subprocess.check_output(['/usr/bin/git', '--no-replace-objects', *args], cwd=repo, timeout=30)

roots, declarations = {}, []
for path in sorted((root / 'scripts').glob('rc_pretag*.py')):
    values = {}
    for node in ast.parse(path.read_bytes()).body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            try: values[node.targets[0].id] = ast.literal_eval(node.value)
            except (ValueError, TypeError): pass
    for name in ('M', 'F', 'P', 'R', 'BASE', 'ORIGIN', 'RELEASE', 'CURRENT_PARENT'):
        oid = values.get(name)
        if not isinstance(oid, str) or not re.fullmatch('[0-9a-f]{40}', oid): continue
        raw = read(root, 'cat-file', 'commit', oid)
        assert raw == read(trusted, 'cat-file', 'commit', oid)
        assert hashlib.sha1(b'commit ' + str(len(raw)).encode() + b'\0' + raw).hexdigest() == oid
        header = raw.split(b'\nauthor ', 1)[0].decode().splitlines()
        tree, parents = header[0][5:], [line[7:] for line in header[1:]]
        expected_tree, expected_parents = values.get(name + '_TREE'), values.get(name + '_PARENTS')
        if expected_tree is not None: assert tree == expected_tree
        if expected_parents is not None: assert parents == list(expected_parents)
        roots[oid] = dict(raw_bytes=len(raw), raw_sha256=hashlib.sha256(raw).hexdigest(), tree=tree, ordered_parents=parents)
        declarations.append(dict(path=str(path.relative_to(root)), name=name, oid=oid, declared_tree=expected_tree, declared_parents=list(expected_parents) if expected_parents is not None else None))

release = 'e2e011f7f2a3a1df838bbd588106205b999db610'
assert release in roots and '70aa9e3644fc50861992717c6c879d8c7261539f' in roots
blobs = ['f44a9b8abf0dac1e35cea0e23b36750b297d0704', 'c5cffd2d3dba5ce70f4dbe41167cf9f699c807d3', '7dd36643c0931fd5c8b6e2c2de8152b2f4c0366c', 'de0f6f90e184bb41af7bb714ad425e51f0a9d819']
names = ['next-rc-ledger.md', 'next-rc-notes.md', 'source-acceptance-audit.md', 'verification-v0.6.0-rc.4.md']
documents = []
for name, blob in zip(names, blobs):
    path = 'docs/releases/' + name
    assert read(root, 'ls-tree', release, '--', path).decode().strip() == '100644 blob ' + blob + '\t' + path
    data = read(root, 'cat-file', 'blob', blob)
    assert data == read(trusted, 'cat-file', 'blob', blob)
    assert hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest() == blob
    documents.append(dict(path=path, mode='100644', blob=blob, bytes=len(data), sha256=hashlib.sha256(data).hexdigest()))
fsck = subprocess.run(['/usr/bin/git', 'fsck', '--full', '--no-reflogs'], cwd=root, capture_output=True, timeout=30)
assert fsck.returncode == 0
expected_roots = dict(EXPECTED_BASE_ROOTS)
expected_declarations = list(EXPECTED_BASE_DECLARATIONS)
if stage == 'candidate-b227':
    expected_roots['c60f9667fa8431e27fabbc497c19b4abfef5b965'] = D6_CURRENT_ROLE
    expected_declarations.append(dict(path='scripts/rc_pretag_windows_launch_profile.py',name='CURRENT_PARENT',oid='c60f9667fa8431e27fabbc497c19b4abfef5b965',declared_tree=None,declared_parents=None))
assert roots == expected_roots
assert sorted(declarations,key=lambda v:(v['path'],v['name'])) == sorted(expected_declarations,key=lambda v:(v['path'],v['name']))
assert (len(roots),len(declarations)) == ((26,30) if stage == 'base-d6' else (27,31))
proof = dict(scope='Current actual native historical dependency admission; not SUT PASS', root=str(root), trusted_root=str(trusted), roots=roots, declarations=declarations, release_documents=documents, fsck_exit=0, fsck_stdout_sha256=hashlib.sha256(fsck.stdout).hexdigest(), fsck_stderr_sha256=hashlib.sha256(fsck.stderr).hexdigest(), required_unique_commit_roots=len(expected_roots),source_stage=stage, declaration_count=len(declarations), source_dependency_admitted=True)
with out.open('x') as stream: stream.write(json.dumps(proof, sort_keys=True, indent=2) + '\n')
print(json.dumps(dict(native_roots=len(roots), source_stage=stage, declarations=len(declarations), release_docs=4, fsck_exit=0, SUT_tests_started=0)))
