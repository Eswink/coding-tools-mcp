functions=('record_pending_credential','observed_credential','credential_provenance_for_fixture',
 'retire_credential_provenance','install_bindings','restore_bindings','finish_observation')
original=owned._credential;rows=[]
def namespace():
 ns=dict(threading=threading,wire=wire,executor=executor,fixture_source=fixture_source,
  _worker_thread=threading.get_ident(),_delegate_credential=original,_credential_records=[],
  _credential_outcomes=[],_credential_registry_retired=False,_observer_cancels=[],
  _observer_primary_exceptions=[],_observation_errors=[],_restore_errors=[],_install_errors=[],
  _installed_complete=False,_applied=[],_bindings=[],_auth_setup_failures=[],_activations=[],
  _observations=[],_tls_observations=[],_auth_observations=[],_auth_binding_outcomes=[],
  _bootstrap_auth_outcome=None,_live_clients=[],_owned_requests={},json=json,sys=sys,
  write=lambda *a:None)
 exec(compile(ast.Module(body=[nodes[n] for n in functions],type_ignores=[]),str(B/'diagnostic_worker.py'),'exec'),ns)
 return ns
class Broken(list):
 def __init__(self,error):self.error=error
 def append(self,value):raise self.error
class PendingObserve:
 def __init__(self,error):self.error=error
 def __call__(self,*args):raise self.error

def create(ns,fixture):
 calls=[]
 def delegate(*args):
  calls.append(args)
  return original(*args)
 ns['_delegate_credential']=delegate
 with patch.object(owned,'_credential',ns['observed_credential']):
  session=executor.PublisherSession(fixture.root,fixture.selection,'fixture-token',temporary_parent=fixture.parent)
 assert len(calls)==1 and session._api._credential._client is session._api
 return session

def emit(name):rows.append(dict(name=name,passed=True))
with publisher_fixture() as fixture:
 with fixture_source.ArtifactTLS(fixture) as tls:
  sessions=[];socks=[]
