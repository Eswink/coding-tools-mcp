import sys,json,hashlib,stat,subprocess,ast
from pathlib import Path
sys.dont_write_bytecode=True
B=Path('/workspace/work/rc070/publisher-supplementary-git-research/v4');sys.path.insert(0,str(B));import owned_git_prepare_v4 as g
m=g.load_reviewed_git_dependencies();current={}
for name in g.SOURCE5:
 p=B/name;info=p.lstat();assert p.resolve()==p and info.st_nlink==1 and stat.S_IMODE(info.st_mode)==0o600
 current[name]=m.snapshot_debian_tool(p)
msgfmt=g.validate_msgfmt_assignment('/workspace/work/rc070/publisher-debian-msgfmt-research/actual-owned-debian-msgfmt01/preparation-result.json')
runtime={p:m.snapshot_debian_tool(p)for p in (*m.HOST_TOOLS,*m.HOST_LIBRARIES,str(g.TOOLCHAIN/'cargo'),str(g.TOOLCHAIN/'rustc'))}
result=json.loads(Path('/workspace/work/rc070/publisher-review/gitv4-ordinary-result07-repaired.json').read_text());assert result['loaded']==result['success']==25 and result['failures']==result['errors']==0 and result['source_before']==result['source_after']
for name,lease in current.items():assert lease['sha256']==result['source_after'][name]
old=Path('/workspace/work/rc070/publisher-supplementary-git-research/v3/owned_git_prepare_v3.py').read_text();new=(B/'owned_git_prepare_v4.py').read_text();a=ast.parse(old);b=ast.parse(new)
for name in ('snapshot_original_git_source','run_owned_git_phase'):
 x=next(n for n in a.body if isinstance(n,ast.FunctionDef)and n.name==name);y=next(n for n in b.body if isinstance(n,ast.FunctionDef)and n.name==name);assert ast.get_source_segment(old,x)==ast.get_source_segment(new,y)
graph=B/'source-graph'
def git(*args):return subprocess.run(['/usr/bin/git','-C',str(graph),*args],check=True,capture_output=True).stdout
index=git('ls-files','--stage','-z');rows=[]
for row in index.split(b'\0'):
 if not row:continue
 meta,path=row.split(b'\t');mode,blob,stage=meta.decode().split();name=path.decode();assert stage=='0';raw=(graph/name).read_bytes();assert git('cat-file','blob',blob)==raw;rows.append({'path':name,'git_mode':mode,'blob':blob,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()})
assert set(x['path']for x in rows)==set(g.SOURCE5)|{'.gitignore'}
for name in g.SOURCE5:assert (graph/name).read_bytes()==(B/name).read_bytes()
assert {name:m.snapshot_debian_tool(B/name)for name in g.SOURCE5}==current
assert {p:m.snapshot_debian_tool(p)for p in runtime}==runtime
assert g.validate_msgfmt_assignment('/workspace/work/rc070/publisher-debian-msgfmt-research/actual-owned-debian-msgfmt01/preparation-result.json')==msgfmt
out={'schema':'V4-source-current-readonly-freeze-not-fullbuild','current_source5':current,'current_runtime':runtime,'current_msgfmt':msgfmt,'graph_native_HEAD':git('rev-parse','HEAD').decode().strip(),'graph_native_tree':git('write-tree').decode().strip(),'graph_native_index_sha256':hashlib.sha256(index).hexdigest(),'graph_all6_nativeblob_current_rows':rows,'ordinary25_actual_tool_provenance':{'session':81894,'start_chunk':'30bc44','terminal_chunk':'272a4b','tool_exit_code':0},'original4991_control_before_after':True,'protected_two_AST_and_function_bytes_exact':True,'ordinary_automatic_nativeowner_cancel':'NOTRUN','fullbuild':'NOTRUN','install':'NOTRUN','SUT_originalmethods':0,'source_peer':'LIMITED_PASS_further_final_freeze_peer_pending'}
with open('/workspace/work/rc070/publisher-review/GIT-V4-CURRENT-SOURCE-FREEZE01.json','x')as f:json.dump(out,f,indent=2);f.write('\n')
print(json.dumps({'source5':len(current),'runtime':len(runtime),'graph_native_files':len(rows),'graph_native_tree':out['graph_native_tree'],'fullbuild':False,'install':False,'SUT_originalmethods':0}))
