   with self.assertRaises(ValueError):g._config_row(s/'config.mak',g.serialize_msgfmt_config(base),r['parents'][''])
  self.assertEqual(len(calls),1);self.assertEqual(calls[0].state,'CLOSED')
 def test_late_presence_cancel_preserves_open_primary_and_all_parents(self):
  s=self.source();base=self.base();r={};primary=OSError('first-open-no-return');cancel=KeyboardInterrupt('late-presence');opened=g.os.open;exists=Path.exists;lstat=Path.lstat;presence=[];parents=[];fault=[False]
  def opening(path,flags,*a,**kw):
   if flags&os.O_CREAT:fault[0]=True;raise primary
   return opened(path,flags,*a,**kw)
  def observed(path):
   if path==s/'config.mak':
    presence.append(path)
    if fault[0]:raise cancel
   return exists(path)
  def statted(path,*a,**kw):
   if fault[0]and path in (s,s/'git-gui'):parents.append(path)
   return lstat(path,*a,**kw)
  with patch.object(g.os,'open',side_effect=opening),patch.object(Path,'exists',observed),patch.object(Path,'lstat',statted):
   with self.assertRaises(BaseException)as e:g.prepare_owned_msgfmt_configs(s,base,r)
  self.assertIn(primary,leaves(e.exception));self.assertIn(cancel,leaves(e.exception));self.assertEqual(parents,[s,s/'git-gui']);self.assertFalse(r['complete'])
 def test_policy_observer_cancel_all_seven_independent_paths(self):
  s=self.source();base=self.base();r={};g.prepare_owned_msgfmt_configs(s,base,r);exists=Path.exists;cancel=SystemExit('first-policy-observation');seen=[]
  def observed(path):
   if path.name in g._CONFIG_POLICY_NAMES:
