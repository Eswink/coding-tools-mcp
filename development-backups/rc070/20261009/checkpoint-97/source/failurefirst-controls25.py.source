  self.assertIn(cancel,leaves(e.exception));self.assertIsInstance(e.exception,BaseExceptionGroup);self.assertEqual(len(seen),7)
 def preparation_fixture(self):
  # Explicitly synthetic source fixture, not signature/original4991 proof.
  def extracted(_tar,destination):
   destination=Path(destination);destination.mkdir();source=destination/'git-2.55.0';source.mkdir();(source/'git-gui').mkdir();(source/'gitk-git').mkdir()
   (source/'Makefile').write_bytes((OLD_SOURCE/'Makefile').read_bytes());return source
  tools={'passed':True,'runtime':{},'build_env':{'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C'}}
  guard={n:g.load_reviewed_git_dependencies().snapshot_debian_tool(g.OWNED_ROOT/n)for n in g.SOURCE5}
  return extracted,tools,guard
 def test_controlled_prepare_false_no_config_make_or_install(self):
  extract,tools,guard=self.preparation_fixture()
  with patch.object(g,'verify_git_source',return_value=b'controlled unsignedfixture'),patch.object(g,'extract_owned_git_source',side_effect=extract),patch.object(g,'run_owned_git_phase')as run:
   r=g.prepare_owned_git_v4(None,None,None,self.root/'prepared',ACTUAL_MSGFMT,execute=False)
  self.assertEqual(r['status'],'PREPARED_NOT_EXECUTED');self.assertEqual(r['build_runs'],0);self.assertEqual(r['INSTALL'],'NOTRUN');run.assert_not_called();self.assertFalse((self.root/'prepared/source/git-2.55.0/config.mak').exists())
 def test_controlled_build_failure_exact_no_MSGFMT_CLI_install_zero(self):
