 def test_genuine_malformed_core_reject_and_original_GUI_target(self):
  oldmod=types.ModuleType('ordinary_readonly_original_git_v3_source_guard')
  oldpath=OLD_SOURCE.parents[2]/'owned_git_prepare_v3.py'
  exec(compile(oldpath.read_bytes(),str(oldpath),'exec'),oldmod.__dict__)
  original4991=json.loads((OLD_SOURCE.parent/'SOURCE-MANIFEST.json').read_text());self.assertEqual(len(original4991),4991)
  self.assertEqual(oldmod.snapshot_original_git_source(OLD_SOURCE,original4991),original4991)
  msg=g.validate_msgfmt_assignment(ACTUAL_MSGFMT);base=msg['vector'];m=g.load_reviewed_git_dependencies();source_files=(OLD_SOURCE/'git-gui/Makefile',OLD_SOURCE/'git-gui/po/zh_cn.po');before={str(p):m.snapshot_debian_tool(p)for p in source_files}
  bad=self.root/'malformed.po';bad.write_bytes(b'msgid "unterminated\n')
  x=subprocess.run([*base,'--check','-o',str(self.root/'malformed.mo'),str(bad)],cwd=self.root,env={'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C'},capture_output=True,timeout=10);self.assertNotEqual(x.returncode,0)
  s=self.source();(s/'git-gui/po').mkdir();r={};g.prepare_owned_msgfmt_configs(s,base,r)
  for p in source_files:
   q=s/'git-gui'/p.relative_to(OLD_SOURCE/'git-gui');q.write_bytes(m.owned_debian_file_io(p,read_limit=8*1024*1024+1));self.assertEqual(q.read_bytes(),p.read_bytes())
  # Sole original translation target; no all/install target or original source edits.
  selftest=subprocess.run([*base,'--tcl','-l','C','-d','.','/dev/null'],cwd=s/'git-gui',env={'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C'},capture_output=True,timeout=10);self.assertEqual(selftest.returncode,0)
  x2=subprocess.run(['/usr/bin/make','--no-print-directory','V=1','-C',str(s/'git-gui'),'po/zh_cn.msg'],cwd=s,env={'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C'},capture_output=True,timeout=30)
  self.assertEqual(x2.returncode,0,x2.stderr);self.assertTrue((s/'git-gui/po/zh_cn.msg').is_file());self.assertNotIn(b'po2msg',x2.stdout+x2.stderr);self.assertEqual(shlex.split(x2.stdout.decode().splitlines()[0]),[*base,'--statistics','--tcl','-l','zh_cn','-d','po/','po/zh_cn.po'])
  self.assertEqual(g.validate_msgfmt_assignment(ACTUAL_MSGFMT),msg);self.assertEqual({str(p):m.snapshot_debian_tool(p)for p in source_files},before);g.verify_owned_msgfmt_configs(s,r,g.serialize_msgfmt_config(base))
  self.assertEqual(oldmod.snapshot_original_git_source(OLD_SOURCE,original4991),original4991)
  OBSERVATIONS.append({'GUI_original_selftest_exit':selftest.returncode,'original4991_full_before_after_exact':True,'component':'genuineGNUmsgfmt core malformed and originalGUI translation only','malformed_exit':x.returncode,'original_GUI_target_exit':x2.returncode,'original_GUI_makefile_sha256':before[str(source_files[0])]['sha256'],'original_GUI_PO_sha256':before[str(source_files[1])]['sha256'],'original_source_inputs_unchanged':True,'fullbuild':False,'install':False,'component_stdout_sha256':hashlib.sha256(x2.stdout).hexdigest(),'component_stderr_sha256':hashlib.sha256(x2.stderr).hexdigest()})

