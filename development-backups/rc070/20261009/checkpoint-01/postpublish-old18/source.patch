+    def download(self, remote):
+        owner, controls = self._owner, self._controls
+        with owner.sink(remote.asset) as sink:
+            status, headers, measured = self._request('GET', wire.API,
+                wire.ROOT + '/releases/assets/' + str(remote.asset_id), anonymous=True,
+                binary=True, limit=remote.asset.size, deadline=controls._deadline, sink=sink)
+            if status == 200:
+                sink.finish(measured)
+                return
+            need(status == 302, 'post_asset_not_public')
+        location = headers.get('location', '')
+        need(type(location) is str and len(location) <= 8192
+             and all(33 <= ord(c) < 127 for c in location), 'post_storage_denied')
+        try:
+            parsed = urlsplit(location)
+            allowed = (parsed.scheme == 'https' and parsed.hostname == wire.STORAGE
+                       and parsed.port in (None, 443) and parsed.username is None
+                       and parsed.password is None and not parsed.fragment
+                       and parsed.path.startswith('/') and not parsed.path.startswith('//'))
+        except ValueError:
+            allowed = False
+        need(allowed, 'post_storage_denied')
+        self._storage_path = parsed.path + ('?' + parsed.query if parsed.query else '')
+        try:
+            with owner.sink(remote.asset) as sink:
+                status, _, measured = self._request('GET', wire.STORAGE, self._storage_path,
+                    anonymous=True, binary=True, limit=remote.asset.size,
+                    deadline=controls._deadline, sink=sink)
+                need(status == 200, 'post_second_redirect')
+                sink.finish(measured)
+        finally:
+            self._storage_path = None
+
+
+class PublishedInputs:
+    """An actual entered stage and fixed anonymous reads own six real files."""
+    def __init__(self, stage, request, controls, *, temporary_parent):
+        need(type(stage) is StagedAssets and stage._entered and not stage._closed
+             and type(request) is CaptureRequest and request.selection == stage._selection
+             and type(controls) is ReadController, 'invalid_post_stage')
+        need(type(stage._api) is _ReferenceAPI and stage._api._selection is stage._selection
+             and stage._api._controls is controls, 'invalid_post_reference')
+        self._stage, self._request, self._controls = stage, request, controls
+        self._owner = InputOwner(temporary_parent, stage._root, controls)
+        self._api = _Anonymous(stage, request, controls, self._owner)
+        self._entered = self._verified = self._closed = False
+
+    def __enter__(self):
+        need(not self._entered and not self._closed, 'post_inputs_reused')
+        self._entered = True
+        try:
+            self._stage.revalidate(**self._controls.budget)
+            self._inventory = self._api.inventory()
+            for asset in self._inventory:
+                self._api.download(asset)
+            self._check_bytes()
+            self.revalidate()
+            self._verified = True
+            return self
+        except BaseException:
+            self.close()
+            raise
+
+    def _check_bytes(self):
+        self._owner.check()
+        plan, raw = self._stage.plan, self._owner._root
+        need(set(raw.files()) == {a.name for a in plan.assets}, 'post_raw_inventory_changed')
+        for asset in plan.assets:
+            self._owner.verify(asset)
+        need(raw.read('RC_PROVENANCE.json') == self._stage.provenance_bytes, 'post_provenance_changed')
+        checksums = ''.join(a.sha256 + '  ' + a.name + '\n'
+                            for a in sorted(plan.assets[:-1], key=lambda a: a.name)).encode('ascii')
+        need(raw.read(plan.assets[-1].name) == checksums, 'post_checksums_changed')
+        need(hashlib.sha256(self._stage.plan_bytes).hexdigest() == self._stage.subject.plan_sha256,
+             'post_plan_changed')
+
+    def revalidate(self):
+        need(self._entered and not self._closed, 'post_input_lifetime')
+        self._owner.check()
+        self._check_bytes()
+        need(self._api.inventory() == self._inventory, 'post_public_inventory_changed')
+        self._stage.revalidate(**self._controls.budget)
+        self._owner.check()
+
+    def close(self):
+        if not self._closed:
+            self._closed = True
+            self._owner.close()
+
+    def __exit__(self, *_):
+        self.close()
