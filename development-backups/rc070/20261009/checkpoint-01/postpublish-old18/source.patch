+class PostpublicationCases(unittest.TestCase):
+    def test_external_sink_rejected_before_body_retention(self):
+        with HTTPSFixture() as tls, patch.object(wire, '_connect', side_effect=tls.connect):
+            with wire._connect(wire.API, 3) as sock:
+                sock.sendall(('GET ' + wire.ROOT + '/releases/latest HTTP/1.1\r\nHost: ' +
+                              wire.API + '\r\nConnection: close\r\n\r\n').encode())
+                import time
+                reader = wire._Reader(sock, time.monotonic() + 3, lambda: None)
+                with self.assertRaises(wire.WireFailure) as found:
+                    reader.response(1024, binary=True, sink=object())
+                self.assertEqual((found.exception.code, found.exception.effect), ('invalid_request', 'none'))
+
+    def test_six_actual_anonymous_files_and_retirement(self):
+        with public_fixture() as (f, tls, request, controls, stage):
+            self.assertIs(stage._api._selection, stage._selection)
+            self.assertIs(stage._api._api.selection, stage._selection)
+            start = len(tls.requests)
+            with PublishedInputs(stage, request, controls, temporary_parent=f.parent) as inputs:
+                path = inputs._owner._root.path
+                self.assertEqual(set(inputs._owner._root.files()), set(f.payloads))
+                for asset in stage.plan.assets:
+                    self.assertEqual(inputs._owner._root.read(asset.name), f.payloads[asset.name])
+                    self.assertEqual(stat.S_IMODE((path / asset.name).stat().st_mode), 0o600)
+                inputs.revalidate()
+            self.assertFalse(path.exists())
+            public = [r for r in tls.requests[start:] if r[1].startswith(wire.ROOT + '/releases')
+                      or r[1].startswith(wire.ROOT + '/git/ref/')]
+            # Stage's authenticated source checks are audited separately. All
+            # numeric public asset requests, including metadata, are anonymous.
+            downloads = [r for r in public if r[1].startswith(wire.ROOT + '/releases/assets/')]
+            self.assertEqual({int(r[1].rsplit('/',1)[1]) for r in downloads}, set(request.asset_ids))
+            self.assertTrue(all('authorization' not in r[2] and 'cookie' not in r[2] and r[0]=='GET'
