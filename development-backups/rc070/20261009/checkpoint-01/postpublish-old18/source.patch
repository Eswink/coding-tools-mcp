+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes((fixtures.ROOT / WORKFLOW).read_bytes())
+        super().commit_source()
+
+
+@contextmanager
+def public_fixture():
+    """Synthetic GitHub shapes; real committed source, TLS, worker IPC and IO."""
+    with patch.object(fixtures, 'SourceFixture', PostSourceFixture), fixtures.publisher_fixture() as f:
+        request = CaptureRequest(f.selection, 100, tuple(range(300, 306)))
+        with HTTPSFixture(f.selection.subject, f.plan, f.payloads) as tls:
+            tls.release = dict(id=100, tag_name=f.selection.subject.tag,
+                target_commitish=f.source.sha, draft=False, prerelease=True, published_at='2026-10-01T01:00:00Z')
+            for ident, asset in zip(request.asset_ids, f.plan.assets):
+                row = dict(id=ident, name=asset.name, content_type=asset.media_type,
+                    size=asset.size, digest='sha256:' + asset.sha256, state='uploaded')
+                tls.assets[ident] = row, f.payloads[asset.name]
+            tls.route = lambda *args: fixtures.artifact_route(f, *args)
+            with patch.object(wire, '_connect', side_effect=tls.connect), fixtures.artifact_worker(f, tls):
+                controls = ReadController()
+                try:
