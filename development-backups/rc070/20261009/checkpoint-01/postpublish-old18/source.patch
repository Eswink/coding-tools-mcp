@@ -0,0 +1,233 @@
+"""Real TLS/worker ZIP and process-local contracts; no actual CI/installer run."""
+from contextlib import contextmanager
+import copy
+from dataclasses import asdict, replace
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+import zipfile
+
+from rc_consumer_io import ConsumerError
+import rc_publication_github as wire
+from rc_postpublication_cases import public_fixture
+from rc_postpublication_contract import (CAPTURE_JOB, MANIFEST, WORKFLOW, CaptureRequest,
+    TransferExpectation, encode, manifest_bytes, request_bytes, transfer_name)
+from rc_postpublication_source import post_invocation
+from rc_postpublication_reader import PublishedInputs
+from rc_postpublication_transfer import TransferPayload, ReceivedInputs, metadata
+
+
+def post_metadata(f, *, complete=False):
+    run = copy.deepcopy(f.api.data['/actions/runs/999'])
+    run.update(id=5001, workflow_id=44, path=WORKFLOW, status='in_progress', conclusion=None,
+        event='workflow_dispatch', created_at='2026-10-01T00:11:00Z',
+        run_started_at='2026-10-01T00:11:01Z', updated_at='2026-10-01T00:16:00Z')
+    job = dict(id=50011, run_id=5001, run_attempt=1, name=CAPTURE_JOB, head_sha=f.source.sha,
+        status='completed' if complete else 'in_progress', conclusion='success' if complete else None,
+        started_at='2026-10-01T00:11:02Z', completed_at='2026-10-01T00:15:00Z' if complete else None)
+    f.api.data.update({'/actions/workflows/' + Path(WORKFLOW).name: dict(id=44, path=WORKFLOW),
+        '/actions/runs/5001': run, '/actions/runs/5001/attempts/1': copy.deepcopy(run),
+        '/actions/runs/5001/attempts/1/jobs?per_page=100&page=1': dict(total_count=1, jobs=[job])})
+    return dict(GITHUB_EVENT_NAME='workflow_dispatch', GITHUB_REPOSITORY=f.selection.subject.source.repository,
+        GITHUB_REPOSITORY_ID=str(f.selection.subject.source.repository_id), GITHUB_RUN_ID='5001',
+        GITHUB_RUN_ATTEMPT='1', GITHUB_SHA=f.source.sha, GITHUB_WORKFLOW_SHA=f.source.sha,
+        GITHUB_REF='refs/heads/' + run['head_branch'],
+        GITHUB_WORKFLOW_REF=f.selection.subject.source.repository + '/' + WORKFLOW + '@refs/heads/' + run['head_branch'])
+
+
+def artifact_bytes(root, replacements=None, extra=None):
+    replacements, extra = replacements or {}, extra or {}
+    output = io.BytesIO()
+    with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_STORED) as archive:
+        for name in root.files():
+            archive.writestr(name, replacements.get(name, root.read(name)))
+        for name, data in extra.items():
+            archive.writestr(name, data)
+    return output.getvalue()
+
+
+def set_transfer(f, invocation, data, ident=51):
+    f.archives[ident] = data
+    item = dict(id=ident, name=transfer_name(invocation), size_in_bytes=len(data),
+        digest='sha256:' + hashlib.sha256(data).hexdigest(), expired=False,
+        created_at='2026-10-01T00:14:00Z', updated_at='2026-10-01T00:14:01Z', expires_at='2080-01-01T00:00:00Z',
+        workflow_run=dict(id=invocation.run_id, repository_id=invocation.source.repository_id,
+            head_repository_id=invocation.source.repository_id, head_sha=invocation.source.source_sha,
+            head_branch=invocation.ref.removeprefix('refs/heads/')))
+    f.api.data['/actions/artifacts/' + str(ident)] = copy.deepcopy(item)
+    f.api.data[f'/actions/runs/{invocation.run_id}/artifacts?per_page=100&page=1'] = dict(total_count=1, artifacts=[copy.deepcopy(item)])
+    return TransferExpectation(ident, len(data), hashlib.sha256(data).hexdigest())
+
