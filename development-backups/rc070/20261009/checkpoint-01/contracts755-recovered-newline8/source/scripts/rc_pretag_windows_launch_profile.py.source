    'scripts/rc_pretag_staging_budget_cases.py': 1,
    'scripts/rc_pretag_checksum_budget_cases.py': 2,
    'scripts/rc_pretag_archive_budget_cases.py': 1,
    '.github/workflows/rc-pretag-contract-checks.yml': 1,
    'scripts/rc_pretag_publication_tests.py': 1,
    'scripts/rc_pretag_publication_adapters.py': 4,
}
DISPATCH = b'    import rc_pretag_windows_launch_profile as windows_launch\n    selected = windows_launch.select(ref, root, git, entries, historical, release, release_tree, documents)\n    if selected is not None:\n        return selected\n'
NORMALIZE = b'    from rc_pretag_windows_launch_profile import normalize as windows_launch_bytes\n    current = windows_launch_bytes(path, current)\n'
CLASS = 'rc_pretag_windows_launch_cases.WindowsLaunchCompositionCases'
NAMES = (
    'test_actual_f_identity_and_fresh_historical_validation',
    'test_exact_ordered_d_i_j_and_four_document_overlay',
    'test_wrong_repeated_nested_and_same_tree_topologies_reject',
    'test_nineteen_exact_paths_modes_pins_and_entry_count',
    'test_individual_and_aggregate_caps_reject',
    'test_eleven_full_byte_inverses_and_six_dispatch_lines',
    'test_finite_historical_identities_are_exact_and_immutable',
    'test_missing_duplicate_outside_and_binary_inverse_changes_reject',
    'test_selected_historical_and_release_failures_are_terminal',
    'test_current_candidate_is_never_cached',
    'test_original1597_strict303_consumer452_ids_and_assertions_are_preserved',
    'test_new12_inventory_readonly_workflows_and_exceptional_outcomes',
)
NEW_CASES = {CLASS: NAMES}
DIGEST = '2f7a5164c0651dcb4c7b6a2ed26a6a7f434ccd6bef7d0c6e05cffb134ee44154'


def require_sealed():
    """An explicit draft fence; a placeholder can never behave as an old profile."""
    assert SEALED is True, 'UNSEALED Windows launch draft; binding and scope review required'
    assert len(M) == len(M_TREE) == 40 and all(c in '0123456789abcdef' for c in M + M_TREE)
    assert BASE_ENTRY_COUNT > 0 and SOURCE_ENTRY_COUNT == BASE_ENTRY_COUNT + 9
    assert len(M_PARENTS) == 2 and all(len(parent) == 40 for parent in M_PARENTS)
    assert (len(M_RAW_BYTES), hashlib.sha256(M_RAW_BYTES).hexdigest()) == M_RAW
    assert hashlib.sha1(b'commit ' + str(len(M_RAW_BYTES)).encode() + b'\0' + M_RAW_BYTES).hexdigest() == M
    assert set(BASE_PINS) == set(MODIFIED) and len(BASE_PINS) == 20
    assert SOURCE_PINS.keys() == CAPS.keys() - {PROFILE}
    assert FRAGMENTS.keys() == BASE_PINS.keys()
    assert PRIOR_PINS.keys() <= BASE_PINS.keys() and PRIOR_COUNTS.keys() == PRIOR_PINS.keys()
    assert {path: len(pins) for path, pins in PRIOR_PINS.items()} == PRIOR_COUNTS
    assert (len(CURRENT_RAW_BYTES), hashlib.sha256(CURRENT_RAW_BYTES).hexdigest()) == CURRENT_RAW
    assert hashlib.sha1(b'commit ' + str(len(CURRENT_RAW_BYTES)).encode() + b'\0' + CURRENT_RAW_BYTES).hexdigest() == CURRENT_PARENT
    assert (len(CORRECTION_RAW_BYTES), hashlib.sha256(CORRECTION_RAW_BYTES).hexdigest()) == CORRECTION_RAW
    assert hashlib.sha1(b'commit ' + str(len(CORRECTION_RAW_BYTES)).encode() + b'\0' + CORRECTION_RAW_BYTES).hexdigest() == CORRECTION_PARENT
    assert (len(PREVIOUS_RAW_BYTES), hashlib.sha256(PREVIOUS_RAW_BYTES).hexdigest()) == PREVIOUS_RAW
    assert hashlib.sha1(b'commit ' + str(len(PREVIOUS_RAW_BYTES)).encode() + b'\0' + PREVIOUS_RAW_BYTES).hexdigest() == PREVIOUS_PARENT
    assert (len(EARLIER_RAW_BYTES), hashlib.sha256(EARLIER_RAW_BYTES).hexdigest()) == EARLIER_RAW
    assert hashlib.sha1(b'commit ' + str(len(EARLIER_RAW_BYTES)).encode() + b'\0' + EARLIER_RAW_BYTES).hexdigest() == EARLIER_PARENT
    assert (len(OLDER_RAW_BYTES), hashlib.sha256(OLDER_RAW_BYTES).hexdigest()) == OLDER_RAW
    assert hashlib.sha1(b'commit ' + str(len(OLDER_RAW_BYTES)).encode() + b'\0' + OLDER_RAW_BYTES).hexdigest() == OLDER_PARENT
    assert (len(INITIAL_RAW_BYTES), hashlib.sha256(INITIAL_RAW_BYTES).hexdigest()) == INITIAL_RAW
    assert hashlib.sha1(b'commit ' + str(len(INITIAL_RAW_BYTES)).encode() + b'\0' + INITIAL_RAW_BYTES).hexdigest() == INITIAL_PARENT


def normalize(path, current):
    """Exact local inverse only; never call an older normalizer or read a candidate."""
    require_sealed()
    assert type(path) is str and type(current) is bytes, 'windows_launch inverse input'
    if path not in BASE_PINS:
        return current
    identity = o.pin(current)
    baseline = BASE_PINS[path]
    if identity == baseline[1:3] or identity in PRIOR_PINS.get(path, ()):
        return current
    row = SOURCE_PINS[path]
    assert (identity, len(current), len(current.splitlines())) == (row[1:3], row[3], row[4]), path
    restored = current
    for before, after in reversed(FRAGMENTS[path]):
        assert type(before) is bytes and type(after) is bytes
        assert before and restored.count(before) == 1, 'windows_launch fragment missing or duplicated'
        restored = restored.replace(before, after, 1)
    assert (o.pin(restored), len(restored), len(restored.splitlines())) == (
        baseline[1:3], baseline[3], baseline[4]), 'complete windows_launch F inverse'
    return restored


def topology(ref, root, git, release):
    """Only D[actual D6], I[F,D], J[R,I], retaining exact D5/D4/D3/D2/D750 anchors."""
    require_sealed()
    parents = o._parents(ref, root, git)
    if parents == [CURRENT_PARENT]:
        kind, tip, source = 'nonrelease', ref, ref
    elif len(parents) == 2 and parents[0] == M:
        kind, tip, source = 'nonrelease', ref, parents[1]
    elif len(parents) == 2 and parents[0] == p.R:
        kind, tip = 'release', parents[1]
        feature_parents = o._parents(tip, root, git)
        if len(feature_parents) != 2 or feature_parents[0] != M:
            raise o.TopologyError('windows_launch_feature_parents')
        source = feature_parents[1]
    else:
        raise o.TopologyError('windows_launch_candidate_parents')
    source_parents = o._parents(source, root, git)
    if source_parents != [CURRENT_PARENT]:
        raise o.TopologyError('windows_launch_candidate_parent')
    assert o._parents(CURRENT_PARENT, root, git) == [CORRECTION_PARENT], 'windows_launch current D6 parent'
    assert git('rev-parse', CURRENT_PARENT + '^{tree}', root=root).decode().strip() == CURRENT_TREE, 'windows_launch current D6 tree'
    assert git('cat-file', 'commit', CURRENT_PARENT, root=root) == CURRENT_RAW_BYTES, 'windows_launch current D6 raw'
    assert o._parents(CORRECTION_PARENT, root, git) == [PREVIOUS_PARENT], 'windows_launch correction parent'
    assert git('rev-parse', CORRECTION_PARENT + '^{tree}', root=root).decode().strip() == CORRECTION_TREE, 'windows_launch correction tree'
    assert git('cat-file', 'commit', CORRECTION_PARENT, root=root) == CORRECTION_RAW_BYTES, 'windows_launch correction raw'
    assert o._parents(PREVIOUS_PARENT, root, git) == [EARLIER_PARENT], 'windows_launch previous parent'
    assert git('rev-parse', PREVIOUS_PARENT + '^{tree}', root=root).decode().strip() == PREVIOUS_TREE, 'windows_launch previous tree'
    assert git('cat-file', 'commit', PREVIOUS_PARENT, root=root) == PREVIOUS_RAW_BYTES, 'windows_launch previous raw'
    assert o._parents(EARLIER_PARENT, root, git) == [OLDER_PARENT], 'windows_launch earlier parent'
    assert git('rev-parse', EARLIER_PARENT + '^{tree}', root=root).decode().strip() == EARLIER_TREE, 'windows_launch earlier tree'
    assert git('cat-file', 'commit', EARLIER_PARENT, root=root) == EARLIER_RAW_BYTES, 'windows_launch earlier raw'
    assert o._parents(OLDER_PARENT, root, git) == [INITIAL_PARENT], 'windows_launch older parent'
    assert git('rev-parse', OLDER_PARENT + '^{tree}', root=root).decode().strip() == OLDER_TREE, 'windows_launch older tree'
    assert git('cat-file', 'commit', OLDER_PARENT, root=root) == OLDER_RAW_BYTES, 'windows_launch older raw'
    assert o._parents(INITIAL_PARENT, root, git) == [M], 'windows_launch initial parent'
    assert git('rev-parse', INITIAL_PARENT + '^{tree}', root=root).decode().strip() == INITIAL_TREE, 'windows_launch initial tree'
    assert git('cat-file', 'commit', INITIAL_PARENT, root=root) == INITIAL_RAW_BYTES, 'windows_launch initial raw'
    assert release == p.R, 'windows_launch release anchor is terminal'
    return kind, tip, source


def content(ref, root, git, entries, historical, release, release_tree, documents):
    """Validate actual F afresh, all nonself bytes, complete inverses, and exact scope."""
    require_sealed()
    assert (release, release_tree, documents) == (p.R, p.R_TREE, p.R_DOCUMENTS)
    assert len(documents) == 4 and tuple(o._parents(M, root, git)) == M_PARENTS, 'windows_launch F parents'
    assert git('rev-parse', M + '^{tree}', root=root).decode().strip() == M_TREE, 'windows_launch F tree'
    raw = git('cat-file', 'commit', M, root=root)
    assert raw == M_RAW_BYTES and (len(raw), hashlib.sha256(raw).hexdigest()) == M_RAW, 'windows_launch F raw'
    baseline = p.selected_profile(M, root, git, entries, historical, release, release_tree, documents)
    assert baseline == entries(M, root) and len(baseline) == BASE_ENTRY_COUNT
    actual, paths = entries(ref, root), CAPS.keys()
    assert len(paths) == 29 and SOURCE_PINS.keys() == paths - {PROFILE}
    assert baseline.keys() & paths == BASE_PINS.keys() and len(BASE_PINS) == 20
    assert FRAGMENTS.keys() == BASE_PINS.keys() and PRIOR_PINS.keys() <= BASE_PINS.keys()
    assert {path: len(pins) for path, pins in PRIOR_PINS.items()} == PRIOR_COUNTS
    assert all(len(pins) == len(set(pins)) and BASE_PINS[path][1:3] not in pins for path, pins in PRIOR_PINS.items())
    assert actual.keys() == baseline.keys() | paths and len(actual) == SOURCE_ENTRY_COUNT
    assert {path for path in actual if actual[path] != baseline.get(path)} == paths
    assert all(actual[path] == value for path, value in baseline.items() if path not in paths)
    assert all(actual[path][:2] == ('100644', 'blob') for path in paths)
    assert all(actual[path] == (row[0], 'blob', row[1]) for path, row in SOURCE_PINS.items())
    data = {path: git('cat-file', 'blob', actual[path][2], root=root) for path in paths}
    for path, (mode, blob, digest, size, count) in SOURCE_PINS.items():
        assert mode == '100644' and o.pin(data[path]) == (blob, digest), path
        assert (len(data[path]), len(data[path].splitlines())) == (size, count), path
    for path, row in BASE_PINS.items():
        assert baseline[path] == (row[0], 'blob', row[1]), path
        assert normalize(path, data[path]) == git('cat-file', 'blob', baseline[path][2], root=root), path
    p.authenticated._budgets(ref, M, root, git, data, CAPS, DELTA_LIMIT, 'windows_launch_delta_budget')
    return actual


def select(ref, root, git, entries, historical, release, release_tree, documents):
    """Only the topology call delegates; all selected-path failures escape unchanged."""
    require_sealed()
    ref = o._commit(ref, root, git)
    try:
        kind, tip, source = topology(ref, root, git, release)
    except o.TopologyError:
        return None
    expected = content(source, root, git, entries, historical, release, release_tree, documents)
    assert entries(tip, root) == expected, 'windows_launch D/I equal trees'
    if kind == 'release':
        return o.release_content(ref, expected, root, git, entries, release, release_tree, documents)
    return expected
