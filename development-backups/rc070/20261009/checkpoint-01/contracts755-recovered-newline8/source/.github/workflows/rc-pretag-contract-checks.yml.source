                      if code != 0 or failed: failed = True; break
                      receipt = json.loads((directory / (prefix + '-receipt.json')).read_bytes()); valid('consumer', receipt, Path(filename).stem); assert all(record['process']['parent'] == os.getpid() and record['process']['pgrp'] == os.getpgrp() for record in receipt['records']); records.extend(receipt['records'])
              receipt = dict(group='consumer', records=records, passed=not failed, seconds=time.monotonic() - started)
