              assert type(filename) is str and (filename in SHARDS if group == 'pretag' else Path(filename).name == filename and Path(filename).stem in ENTRY_EXPECTED and Path(filename).stem != 'pretag'); prefix = group if filename is None else group + '-' + Path(filename).stem; sys.path.insert(0, str(ROOT / 'scripts')); records, depth, entry, full_ids = [], 0, 'pretag-' + filename if group == 'pretag' else Path(filename).stem, None; events = (directory / (prefix + '-named-events.jsonl')).open('xb')
              def event(value): raw = encode(value); assert events.write(raw) == len(raw); events.flush()
