              with (directory / 'consumer-named-events.jsonl').open('xb') as events:
                  for filename in ['rc_consumer_test_runner.py', *[name + '_tests.py' for name in REGRESSIONS], '发布版本回归v4.py']:
                      process, prefix = None, 'consumer-' + Path(filename).stem
                      try: process = subprocess.Popen([sys.executable, '-B', str(PROGRAM), str(directory), 'consumer', filename], cwd=ROOT); code = process.wait()
                      except BaseException: traceback.print_exc(); failed = True; code = None
                      finally:
                          if process is not None and process.poll() is None:
