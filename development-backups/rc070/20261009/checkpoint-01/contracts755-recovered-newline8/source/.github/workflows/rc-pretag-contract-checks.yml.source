                  child_kernel_waits=[leases[selector] for selector in SHARDS if selector in leases])
              for field in ('loaded_ids', 'executed_ids', 'success_ids'): receipt[field] = [item for record in records for item in record[field]]
              try: valid('pretag', receipt)
