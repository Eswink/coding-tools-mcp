 ns['_observations']=Cancelled();ns['_observer_cancels']=[]
 try:ns[wrapper](object())
 except BaseExceptionGroup as e:assert e.exceptions[0] is exc and e.exceptions[1] is ns['_observer_cancels'][0] and type(e.exceptions[1]) is KeyboardInterrupt
 else:raise AssertionError('cancel lost')
