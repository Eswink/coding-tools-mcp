other=ns['wire'].core.Operation();other.kind='CreateDraft';other.operation_id=11;ns['_request_context']=other;ns['observe_error']('ordinary',RuntimeError());assert ns['_observations']==[];rows.append('other_operation_no_event')
ns['_request_context']=op
for outcome in (object(),RuntimeError('request'),KeyboardInterrupt()):
 previous=object();ns['_request_context']=previous;seen=[]
 def delegated(*args,**kwargs):
  seen.append(ns['_request_context']);assert kwargs['op'] is op
  if isinstance(outcome,BaseException):raise outcome
  return outcome
 ns['_delegate_request']=delegated
 try:value=ns['observed_request'](object(),'POST',op=op)
 except BaseException as e:assert e is outcome
 else:assert value is outcome
 assert seen==[op] and ns['_request_context'] is previous;rows.append('request_context_restore_'+type(outcome).__name__)
previous=object();ns['_request_context']=previous;ns['_worker_thread']=-1;ns['_delegate_request']=Mock(return_value=previous);assert ns['observed_request'](object(),op=op) is previous and ns['_request_context'] is previous;ns['_worker_thread']=before;rows.append('other_thread_request_passthrough_once')
orig1=object();wrap1=object();orig2=object();wrap2=object();t1=SimpleNamespace(hook=orig1);t2=SimpleNamespace(hook=orig2)
ns['_bindings']=[(t1,'hook',orig1,wrap1),(t2,'hook',orig2,wrap2)];ns['_applied']=[];ns['_restore_errors']=[]
ns['install_bindings']();assert t1.hook is wrap1 and t2.hook is wrap2
assert ns['restore_bindings']() and t1.hook is orig1 and t2.hook is orig2;rows.append('ordered_install_reverse_restore_actual_alias_identity')
ns['_applied']=[];ns['_restore_errors']=[];t2.hook=object()
try:ns['install_bindings']()
except RuntimeError:pass
else:raise AssertionError('alias precondition accepted')
assert ns['restore_bindings']() and t1.hook is orig1;rows.append('partial_install_prior_entry_rollback')
t2.hook=orig2;ns['_applied']=[];ns['_restore_errors']=[];ns['install_bindings']();t2.hook=object();assert not ns['restore_bindings']() and t1.hook is orig1 and t2.hook is orig2;rows.append('restore_alias_mismatch_marks_unknown_attempts_all')
ns['_restore_errors']=[];ns['_observer_cancels']=[KeyboardInterrupt()];ns['_observations']=[];ns['_observation_errors']=[];ns['write']=Mock();primary=SystemExit(1)
try:ns['finish_observation'](Path('unused'),primary)
except BaseExceptionGroup as e:assert e.exceptions[0] is primary and e.exceptions[1] is ns['_observer_cancels'][0]
else:raise AssertionError('sticky observer cancellation lost after normalized original request')
assert ns['write'].call_args.args[1]['observation_valid'] is False;rows.append('sticky_cancel_repropagated_after_original_runner')
ns['_observer_cancels']=[];ns['_restore_errors']=[OSError('restore')];ns['write']=Mock()
try:ns['finish_observation'](Path('unused'),primary)
except BaseExceptionGroup as e:assert e.exceptions[0] is primary and e.exceptions[1] is ns['_restore_errors'][0]
else:raise AssertionError('restoreprimary lost')
rows.append('restore_error_and_primary_both_preserved')
ns['_restore_errors']=[];ns['write']=Mock(side_effect=OSError('observerwrite'))
try:ns['finish_observation'](Path('unused'),primary)
except BaseException as e:assert e is primary
else:raise AssertionError('writeprimary lost')
rows.append('observer_write_exception_original_primary_identity')
with tempfile.TemporaryDirectory() as directory:
 file=Path(directory)/'owned';closed=[]
 def actual_write(path,report):
  with path.open('x') as f:
   f.write(json.dumps(report));closed.append(f)
 ns['write']=actual_write
 try:ns['finish_observation'](file,primary)
 except BaseException as e:assert e is primary
 else:raise AssertionError('finishprimary lost')
 assert len(closed)==1 and closed[0].closed and file.is_file();rows.append('ordinary_actual_owned_write_close_then_primary')

class ControlledBinding:
 def __init__(self,original):
  object.__setattr__(self,'original',original);object.__setattr__(self,'hook',original);object.__setattr__(self,'mode',None);object.__setattr__(self,'attempts',[])
 def __setattr__(self,name,value):
  if name=='hook':
   self.attempts.append(value)
   if self.mode=='restorefail' and value is self.original:
    raise OSError('ordinary restore fixture')
   if self.mode=='installafter' and value is not self.original:
    object.__setattr__(self,name,value)
    raise OSError('ordinary install fixture after mutation')
  object.__setattr__(self,name,value)
originals=[object() for _ in range(6)];wrappers=[object() for _ in range(6)];targets=[ControlledBinding(x) for x in originals]
ns['_bindings']=[(t,'hook',o,w) for t,o,w in zip(targets,originals,wrappers)];ns['_applied']=[];ns['_restore_errors']=[]
ns['install_bindings']();targets[-1].mode='restorefail';assert not ns['restore_bindings']()
assert all(targets[k].hook is originals[k] for k in range(5)) and all(targets[k].attempts[-1] is originals[k] for k in range(6));rows.append('first_reverse_restore_failure_other_five_real_attempts_complete')
ns['_observer_cancels']=[];ns['write']=Mock()
try:ns['finish_observation'](Path('unused'),primary)
except BaseExceptionGroup as e:assert e.exceptions[0] is primary and e.exceptions[1] is ns['_restore_errors'][0]
else:raise AssertionError('restorefail masked primary')
rows.append('first_restore_failure_and_runner_primary_group_identity')
targets=[ControlledBinding(x) for x in originals];targets[2].mode='installafter';ns['_bindings']=[(t,'hook',o,w) for t,o,w in zip(targets,originals,wrappers)];ns['_applied']=[];ns['_restore_errors']=[]
try:ns['install_bindings']()
except OSError:pass
else:raise AssertionError('partial install error absent')
assert len(ns['_applied'])==3 and ns['restore_bindings']() and all(t.hook is o for t,o in zip(targets,originals));rows.append('mutated_then_install_error_all_three_rollback_including_failing_entry')
