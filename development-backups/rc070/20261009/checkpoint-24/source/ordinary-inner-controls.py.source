source=(B/'diagnostic_worker.py').read_text()
functions=[n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef)]
ns=dict(Path=Path,threading=threading,traceback=traceback,json=json,sys=__import__('sys'),BaseExceptionGroup=BaseExceptionGroup)
