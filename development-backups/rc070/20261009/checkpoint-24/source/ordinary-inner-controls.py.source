ns['wire']=SimpleNamespace(core=SimpleNamespace(Operation=type('Operation',(),{})),WireFailure=type('WireFailure',(Exception,),{}))
ns['_worker_thread']=threading.get_ident();op=ns['wire'].core.Operation();op.kind='UploadAsset';op.operation_id=11
ns['_request_context']=op;ns['_observations']=[];ns['_observation_errors']=[];ns['_observer_cancels']=[];ns['_restore_errors']=[];ns['_applied']=[]
rows=[]
for wrapper,delegate in [('observed_response','_delegate_response'),('observed_mutation_result','_delegate_mutation_result'),('observed_sendall','_delegate_sendall')]:
 value=object();args=(object(),object());kwargs={'owned':object()};m=Mock(return_value=value);ns[delegate]=m
 assert ns[wrapper](*args,**kwargs) is value and m.call_count==1 and m.call_args.args==args and m.call_args.kwargs==kwargs
 rows.append(wrapper+'_exact_once_args_return_identity')
 for exc in (RuntimeError('ordinary'),SystemExit(7),KeyboardInterrupt()):
  ns['_observations']=[];m=Mock(side_effect=exc);ns[delegate]=m
  try:ns[wrapper](*args,**kwargs)
  except BaseException as e:assert e is exc
  else:raise AssertionError('exception lost')
  assert m.call_count==1 and len(ns['_observations'])==1 and ns['_observations'][0]['error_type']==type(exc).__name__
  rows.append(wrapper+'_original_'+type(exc).__name__+'_identity')
class Broken(list):
 def append(self,value):raise OSError('ordinary observation fixture')
class Cancelled(list):
 def append(self,value):raise KeyboardInterrupt()
for wrapper,delegate in [('observed_response','_delegate_response'),('observed_mutation_result','_delegate_mutation_result'),('observed_sendall','_delegate_sendall')]:
 exc=RuntimeError('primary');ns[delegate]=Mock(side_effect=exc);ns['_observations']=Broken();ns['_observation_errors']=[]
 try:ns[wrapper](object())
 except BaseException as e:assert e is exc
 else:raise AssertionError('primary lost')
