try:ns['finish_observation'](Path('unused'),primary)
except BaseExceptionGroup as e:assert e.exceptions[0] is primary and type(e.exceptions[1]) is KeyboardInterrupt
else:raise AssertionError('write cancel lost')
rows.append('sidecar_write_cancel_and_primary_group')
ns['_observer_cancels']=[];ns['_restore_errors']=[];ns['_request_context']=op;ns['_observations']=Broken();ns['_observation_errors']=[]
exc=RuntimeError('inner');ns['_delegate_response']=Mock(side_effect=exc)
with tempfile.TemporaryDirectory() as directory:
 file=Path(directory)/'owned';owned=file.open('x')
