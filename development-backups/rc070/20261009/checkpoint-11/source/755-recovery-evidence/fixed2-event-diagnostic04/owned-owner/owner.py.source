"""127 originalfixed2 methods plus transparent event observations, never suite qualification."""
from pathlib import Path
import ast, ctypes, hashlib, importlib.util, json, os, stat, sys, traceback, unittest
ROOT, PROGRAM = Path.cwd(), Path(__file__).resolve()
ORIGINAL = Path('/workspace/scratch/566f6003d85e/755-recovery-evidence/inline-current-newline.py')
raw = ORIGINAL.read_bytes()
assert hashlib.sha256(raw).hexdigest() == '8fe7478874c3817858dbb2eabed515dbeb78f268393577a66ba0408ee44922ff'
spec = importlib.util.spec_from_file_location('original_inline_diagnostic_helpers', ORIGINAL)
m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
owned_family_close = m.owned_family_close
encode, flat, digest = m.encode, m.flat, m.digest
actual_fstat, actual_lstat, actual_lseek, actual_write = os.fstat, os.lstat, os.lseek, os.write
actual_json = json.dumps
SELECTED_IDS = ['rc_pretag_collection_tests.CollectionTests.test_all_payload_descriptors_close_before_result_factory', 'rc_pretag_collection_tests.CollectionTests.test_corrupt_actual_zip_stops_before_parser', 'rc_pretag_collection_tests.CollectionTests.test_post_content_fences_reject_mutation_without_reselection', 'rc_pretag_collection_tests.CollectionTests.test_real_current_pipeline_yields_only_bounded_blocked_observation', 'rc_pretag_collection_tests.CollectionTests.test_shared_pipeline_failure_edges_stop_in_exact_order', 'rc_pretag_collection_tests.FailureTests.test_closed_failure_schema_and_sticky_cleanup_uncertainty', 'rc_pretag_collection_tests.FailureTests.test_exact_success_and_failure_caps_include_newline', 'rc_pretag_collection_tests.FailureTests.test_interrupt_timeout_and_unknown_codes_never_claim_cleanup', 'rc_pretag_collection_tests.FailureTests.test_saved_receipt_plan_or_success_dictionary_cannot_be_encoded', 'rc_pretag_collection_tests.OutputLifecycleTests.test_anchored_handoff_rejects_symlink_hardlink_outside_missing', 'rc_pretag_collection_tests.OutputLifecycleTests.test_cleanup_uncertainty_survives_later_close_and_report_errors', 'rc_pretag_collection_tests.OutputLifecycleTests.test_cli_failures_and_cancellation_emit_only_sanitized_nonzero', 'rc_pretag_collection_tests.OutputLifecycleTests.test_cli_token_popped_before_every_git_and_child_and_released', 'rc_pretag_collection_tests.OutputLifecycleTests.test_freeform_fields_never_cross_allowlist', 'rc_pretag_collection_tests.OutputLifecycleTests.test_handoff_consumes_close_authority_once_and_bounds_full_line', 'rc_pretag_collection_tests.OutputLifecycleTests.test_handoff_write_flush_fsync_close_failure_is_terminal', 'rc_pretag_collection_tests.OutputLifecycleTests.test_mutated_raw_and_non_record_output_are_rejected', 'rc_pretag_collection_tests.OutputLifecycleTests.test_numeric_boolean_nonfinite_and_content_authority_rejected', 'rc_pretag_collection_tests.OutputLifecycleTests.test_private_single_file_