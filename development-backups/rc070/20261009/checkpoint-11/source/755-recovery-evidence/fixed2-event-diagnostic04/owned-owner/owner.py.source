_profiles_and_pins_remain_unchanged', 'rc_pretag_nginx_tests.NginxCompositionTests.test_exact_ordered_feature_merge_equals_source_tree', 'rc_pretag_nginx_tests.NginxCompositionTests.test_exact_p_and_single_reviewed_amendment_accept', 'rc_pretag_nginx_tests.NginxCompositionTests.test_exact_release_overlay_contains_only_four_pinned_documents', 'rc_pretag_nginx_tests.NginxCompositionTests.test_frozen_167_plus_20_inventory_has_exact_loaded_and_executed_ids', 'rc_pretag_nginx_tests.NginxCompositionTests.test_missing_extra_renamed_mode_symlink_and_gitlink_entries_reject', 'rc_pretag_nginx_tests.NginxCompositionTests.test_missing_unknown_and_same_tree_impostor_anchors_reject', 'rc_pretag_nginx_tests.NginxCompositionTests.test_mutable_refs_and_ambient_git_redirection_cannot_change_identity', 'rc_pretag_nginx_tests.NginxCompositionTests.test_p_source_has_only_nine_exact_additions', 'rc_pretag_nginx_tests.NginxCompositionTests.test_release_document_byte_mode_path_and_deletion_drift_rejects', 'rc_pretag_nginx_tests.NginxCompositionTests.test_reversed_duplicate_missing_and_extra_parents_reject_before_content', 'rc_pretag_nginx_tests.NginxCompositionTests.test_topology_only_dispatch_keeps_legacy_content_failures_terminal', 'rc_pretag_nginx_tests.NginxCompositionTests.test_unknown_profile_versions_and_native_release_claims_reject']
METHOD = 'rc_pretag_collection_tests.CollectionTests.test_all_payload_descriptors_close_before_result_factory'
def diagnostic_worker(directory):
    sys.path.insert(0, str(ROOT / 'scripts'))
    records, depth, entry, full_ids, group = [], 0, 'pretag-fixed-2', None, 'pretag'
    events_path = directory / 'original-named-events.jsonl'
    events = events_path.open('xb')
    ordinal = 0
    def state():
        value = dict(closed=events.closed)
        if not events.closed:
            fd = events.fileno(); info = actual_fstat(fd)
            value['fd'] = fd
            value['held'] = dict(dev=info.st_dev, inode=info.st_ino, mode=info.st_mode, nlink=info.st_nlink, size=info.st_size)
            value['offset'] = actual_lseek(fd, 0, os.SEEK_CUR)
        info = actual_lstat(events_path)
        value['path'] = dict(dev=info.st_dev, inode=info.st_ino, mode=info.st_mode, nlink=info.st_nlink, size=info.st_size)
        return value
    def observe(stage, **fields):
        value = dict(diagnostic=stage, ordinal=ordinal, state=state(), **fields)
        data = (actual_json(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()
        assert len(data) <= 8192
        assert actual_write(1, data) == len(data)
    def event(value):
        nonlocal ordinal
        raw = encode(value); ordinal += 1
        observe('event-before', payload_bytes=len(raw), payload_sha256=digest(raw), keys=sorted(value))
        returned = events.write(raw)
        observe('event-after-write', returned=returned)
        assert returned == len(raw)
        events.flush()
        observe('event-after-flush')
    original = unittest.TextTestRunner
    class Recorder(original):
        def __init__(self, *args, **kwargs):
            base = kwargs.get('resultclass') or self.resultclass
            class Named(base):
                def __init__(self, *args, **kwargs): super().__init__(*args, **kwargs); self.owned_executed, self.owned_success = [], []
                def startTest(self, test): self.owned_executed.append(test.id()); event(dict(entry=entry, start=test.id())); super().startTest(test)
                def addSuccess(self, test): self.owned_success.append(test.id()); event(dict(entry=entry, success=test.id())); super().addSuccess(test)
            if depth == 0: kwargs['resultclass'] = Named
            super().__init__(*args, **kwargs)
        def run(self, suite):
            nonlocal depth; outer, loaded = depth == 0, [case.id() for case in flat(suite)]
            if outer: event(dict(entry=entry, loaded_ids=loaded))
            depth += 1
            try: result = super().run(suite)
            finally: depth -= 1
            if outer:
                canonical = lambda ids: [entry + value[len('__main__'):] if value.startswith('__main__.') else value for value in ids]
                record = dict(entry=entry, process=dict(pid=os.getpid(), parent=os.getppid(), pgrp=os.getpgrp()), raw_loaded_ids=loaded, raw_executed_ids=result.owned_executed,
                    raw_success_ids=result.owned_success, loaded_ids=canonical(loaded),
                    executed_ids=canonical(result.owned_executed), success_ids=canonical(result.owned_success),
                    testsRun=result.testsRun, passed=result.wasSuccessful(), exceptional=len(result.skipped) +
                    len(result.expectedFailures) + len(result.unexpectedSuccesses) + len(result.errors) + len(result.failures))
                if group == 'pretag': record['full_loaded_ids'] = full_ids
                records.append(record); event(dict(result=record))
            return result

    unittest.TextTestRunner = unittest.runner.TextTestRunner = Recorder
    outcome = None
    try:
        suite = unittest.defaultTestLoader.discover('scripts', pattern='rc_pretag*_tests.py')
        selected, full_ids = m.selected_pretag(suite, 'fixed-2')
        cases = flat(selected)
        assert len(full_ids) == 303 and len(cases) == 127 and cases[0].id() == METHOD
        assert [case.id() for case in cases] == SELECTED_IDS
        observe('before-original-fixed2', actual_selected=127)
        event(dict(entry=entry, full_loaded_ids=full_ids))
        result = unittest.TextTestRunner(verbosity=2).run(selected)
        observe('after-original-fixed2-and-cleanup', testsRun=result.testsRun)
        assert result.testsRun == 127 and result.wasSuccessful()
        assert not result.skipped and not result.expectedFailures and not result.unexpectedSuccesses
        assert len(records) == 1
        for field in ('raw_loaded_ids', 'raw_executed_ids', 'raw_success_ids'):
            assert records[0][field] == SELECTED_IDS
        outcome = dict(diagnostic_original_method_runs=127, qualification_755_runs=0,
            whole755_pass=False, records=records, event_callbacks=ordinal,
            final_state=state(), method_success=True)
    finally:
        events.close()
    m.write_new(directory, 'diagnostic-method-result.json', outcome)
    return 0
if __name__ == '__main__':
    assert len(sys.argv) == 2
    directory = Path(sys.argv[1]); info = directory.lstat()
    assert directory.is_absolute() and directory.resolve() == directory
    assert stat.S_ISDIR(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o700
    assert info.st_uid == os.geteuid() and PROGRAM.parent == directory
    assert list(directory.iterdir()) == [PROGRAM]
    raise SystemExit(diagnostic_worker(directory))
